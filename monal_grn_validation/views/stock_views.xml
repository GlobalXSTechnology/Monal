<odoo>
    <record id="view_stock_return_picking_form" model="ir.ui.view">
        <field name="name">stock.return.picking.form</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_id']" position="before">
                <button name="refresh_return_lines" string="Refresh Lines" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='product_return_moves']/list/field[@name='move_quantity']" position="before">
                <field name="returned_qty" column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>