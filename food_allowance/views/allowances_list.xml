<odoo>
    <data>

        <record id="view_list_restaurant_tree" model="ir.ui.view">
            <field name="name">view_list_restaurant_tree</field>
            <field name="model">restaurant.list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_list_restaurant_form" model="ir.ui.view">
            <field name="name">Restaurants</field>
            <field name="model">restaurant.list</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                    </group>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_list_restaurant" model="ir.actions.act_window">
            <field name="name">Restaurants</field>
            <field name="res_model">restaurant.list</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create Restaurants List</p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_type_list_restaurant"
                  name="Restaurants"
                  parent="hr.menu_human_resources_configuration"
                  action="action_list_restaurant"
                  sequence="10"/>

    </data>
</odoo>
