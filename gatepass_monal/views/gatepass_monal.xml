<odoo>
    <data>
        <record id="view_gatepass_monal_from" model="ir.ui.view">
            <field name="name">monal.gatepass.form</field>
            <field name="model">monal.gatepass</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="proceed_button" string="Proceed" type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="return_button" string="Return" type="object" class="btn-primary"
                                invisible="state != 'returnable'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="action_view_returns"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-reply">
                                <field name="return_count" widget="statinfo" string="Returns"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="type" readonly="1" widget="radio" invisible="1"/>
                                <field name="ware_house" readonly="state != 'draft'"/>
                                <field name="from_location" domain="[('id', 'in', loc_ids)]"
                                       readonly="state != 'draft'" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="ref" readonly="state != 'draft'" invisible="1"/>
                            </group>
                            <group>
                                <field name="transfer_date" readonly="state != 'draft'"/>
                                <field name="transferred_by"/>
                                <field name="remarks" readonly="state != 'draft'"/>
                                <field name="return_of" readonly="1" invisible="not return_of"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="Products">
                                <field name="line_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="returned_qty"/>
                                        <field name="remaining_qty"/>
                                        <field name="return_type"/>
                                        <field name="remarks"/>
                                        <!--                                        <field name="status" readonly="1" widget="tags"/>-->
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="list_view_gatepass_monal" model="ir.ui.view">
            <field name="name">GatePass</field>
            <field name="model">monal.gatepass</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="transfer_date" optional="show"/>
                    <field name="partner_id" optional="show"/>
                    <field name="transferred_by" optional="show"/>
                    <field name="ware_house" optional="show"/>
                    <field name="state" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_gatepass_monal_search" model="ir.ui.view">
            <field name="name">monal.gatepass.search</field>
            <field name="model">monal.gatepass</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="ware_house"/>
                    <field name="transferred_by"/>
                    <field name="transfer_date" string="Transfer Date"/>

                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Returnable" name="returnable" domain="[('state','=','returnable')]"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]"/>
                    <filter string="By Date" name="by_date" date="transfer_date"/>


                    <group expand="0" string="Group By...">
                        <filter string="Warehouse" name="warehouse" context="{'group_by':'ware_house'}"/>
                        <filter string="From Location" name="from_location" context="{'group_by':'from_location'}"/>
                        <filter string="Company" name="company" context="{'group_by':'company_id'}"/>
                        <filter string="Status" name="status" context="{'group_by':'state'}"/>
                        <!--                        <filter string="Transfer Date" context="{'group_by':'transfer_date'}"/>-->
                        <filter string="Transferred By" name="transferred_by" context="{'group_by':'transferred_by'}"/>
                        <!--                        <filter string="Partner" context="{'group_by':'partner_id'}"/>-->
                    </group>
                </search>
            </field>
        </record>

        <record id="gatepass_monal_rule_company" model="ir.rule">
            <field name="name">GatePass Monal: Multi-company</field>
            <field name="model_id" ref="gatepass_monal.model_monal_gatepass"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>


        <record id="gatepass_monal_outwards" model="ir.actions.act_window">
            <field name="name">Outwards GatePass</field>
            <field name="res_model">monal.gatepass</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_type': 'outwards'}</field>
            <field name="domain">[('type', '=', 'outwards')]</field>
        </record>

        <record id="gatepass_monal_inwards" model="ir.actions.act_window">
            <field name="name">Inwards GatePass</field>
            <field name="res_model">monal.gatepass</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_type': 'inwards', 'create': False}</field>
            <field name="domain">[('type', '=', 'inwards')]</field>
        </record>

        <menuitem id="menu_gatepass_monal" name="Inventory Gatepass" action="gatepass_monal_outwards"/>

        <menuitem id="gatepass_type_root" name="GatePass" parent="menu_gatepass_monal"/>

        <menuitem id="outwards_type_menu" name="Outwards GatePass" parent="gatepass_type_root"
                  action="gatepass_monal_outwards"/>
        <menuitem id="inwards_type_menu" name="Inwards GatePass" parent="gatepass_type_root"
                  action="gatepass_monal_inwards"/>


    </data>
</odoo>
