<odoo>

    <record id="seq_gatepass_outwards" model="ir.sequence">
        <field name="name">Gatepass Outwards</field>
        <field name="code">monal.gatepass.outwards</field>
        <field name="prefix">GP/OUT/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_gatepass_inwards" model="ir.sequence">
        <field name="name">Gatepass Inwards</field>
        <field name="code">monal.gatepass.inwards</field>
        <field name="prefix">GP/IN/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>