<odoo>
    <data>

        <record model="ir.ui.view" id="monal_employee_att_report_form">
            <field name="name">monal.attendance.report.employee</field>
            <field name="model">monal.attendance.report.employee</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="select_employee"/>
                            <field name="company_id" invisible="select_employee != 'company'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="department_id" widget="many2many_tags"
                                   invisible="select_employee != 'department'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="employee_ids" widget="many2many_avatar_user"
                                   invisible="select_employee != 'employee'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="show_time_filter" widget="boolean_toggle"/>
                            <field name="check_in_time" widget="time_dropdown"
                                   invisible="show_time_filter == False"/>
                            <field name="check_out_time" widget="time_dropdown"
                                   invisible="show_time_filter == False"/>
                            <field name="source_filter"/>
                            <field name="archived_employee"/>

                        </group>
                        <group class="col-6">

                            <field name="status_filter"/>
                            <field name="work_hours_filter"
                                   invisible="status_filter != 'Work_hours'"/>
                            <field name="from_date"/>
                            <field name="to_date"/>
                        </group>

                    </group>
                    <footer>
                        <button name="print_report_imp" string="Print Attendance" type="object"
                                class="btn btn-success"/>
                        <button string="Close" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="monal_employees_attendance_action_window">
            <field name="name">Employees Monthly Attendace</field>
            <field name="res_model">monal.attendance.report.employee</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="monal_employee_att_report_form"/>

        </record>


        <menuitem id="menu_hr_attendance_employees_daily"
                  name="Monal Employees Monthly Attendance"
                  parent="hr_attendance.menu_hr_attendance_reporting"
                  action="monal_employees_attendance_action_window"
                  sequence="2"/>

        <record id="view_sa_biometric_device_form_inherit" model="ir.ui.view">
            <field name="name">sa.biometric.device.form.inherit</field>
            <field name="model">sa.biometric.device</field>
            <field name="inherit_id" ref="softatt_attendance_zk_extension.view_sa_biometric_device_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="machine_code"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
