<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bulk_leave_encashment_form" model="ir.ui.view">
        <field name="name">bulk.leave.encashment.wizard</field>
        <field name="model">bulk.leave.encashment</field>
        <field name="arch" type="xml">
            <form string="Bulk Leave Encashment">
                <sheet>
                    <group>
                        <group>
<!--                            <field name="period_id"/>-->
                            <field name="month"/>
                            <field name="duration_display" invisible="1"/>
                            <field name="month_start_date" invisible="1"/>
                            <field name="month_end_date" invisible="1"/>

                        </group>
                        <group>
                            <field name="department_ids" widget="many2many_tags"/>
                            <!--                            <field name="encashed_amount"/>-->
                        </group>
                    </group>
                    <div class="mb-3">
    <button string="Load Employees"
            type="object"
            name="action_load_employees"
            class="btn-primary"
            invisible="not month"/>
</div>

                    <notebook>
                        <page name="Employees" string="Employees">
                            <field name="employee_ids" editable="bottom">
                                <list delete="1" editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="attendance_count"/>
                                    <field name="remaining_weekly_off"/>
                                    <field name="encashment_amount"/>
                                    <field name="leave_to_encash"/>
                                    <field name="encashed_amount"/>
                                </list>

                            </field>
                        </page>
                        <page string="Attendance Encashment">
                            <field name="attendance_line_ids">
                                <list delete="1" editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="present_days" readonly="0"/>
                                    <field name="extra_days" readonly="0"/>
                                    <field name="per_day_wage" force_save="1"/>
                                    <field name="days_to_encash" force_save="1"/>
                                    <field name="total_amount" force_save="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_confirm_bulk_encashment" string="Create" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bulk_leave_encashment_action" model="ir.actions.act_window">
        <field name="name">Bulk Leave Encashment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bulk.leave.encashment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="bulk_leave_encashment_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="bulk_leave_encashment_menu_root"
              name="Bulk Leave Encashment"
              parent="monal_leave_encashment.leave_encashment"
              action="bulk_leave_encashment_action"
              sequence="2"/>

</odoo>