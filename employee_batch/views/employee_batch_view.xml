<odoo>


    <record id="action_employee_batch" model="ir.actions.act_window">
        <field name="name">Employees Master</field>
        <field name="res_model">employee.batch</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_employee_batch_form" model="ir.ui.view">
        <field name="name">employees.master.form</field>
        <field name="model">employee.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="badge_id"/>
                        <field name="company_id"/>
                        <field name="contract_id"/>
                        <field name="has_active_contract" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_employee_batch_tree" model="ir.ui.view">
        <field name="name">employee.batch.list</field>
        <field name="model">employee.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="badge_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>


    <menuitem id="menu_employee_batch_root"
              name="Employees Master"
              sequence="10"/>

    <menuitem id="menu_employee_batch"
              name="Batches"
              parent="menu_employee_batch_root"
              action="action_employee_batch"/>

</odoo>
