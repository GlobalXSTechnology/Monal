<odoo>
    <record id="global_input_company_rule" model="ir.rule">
        <field name="name">Global Input: Multi-company restriction</field>
        <field name="model_id" ref="model_global_input"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>

</odoo>
