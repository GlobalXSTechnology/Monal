<odoo>
    <data>
        <record model="ir.ui.view" id="deduction_type_wise_report_form">
            <field name="name">Deduction Type Wise Report</field>
            <field name="model">deduction.wise.report</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="structure_ids" widget="many2many_tags"/>
                            <field name="period"/>
                            <field name="date_from" invisible="1"/>
                            <field name="date_to" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="rule_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <footer>
                        <button name="print_deduction_type_wise_report" string="Print Report" type="object" class="btn-primary"/>
                        <button string="Close" class="btn-danger" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="deduction_type_wise_report_action">
            <field name="name">Deduction Type Wise Report Action</field>
            <field name="res_model">deduction.wise.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


        <menuitem name="Deduction Type Wise Report" id="deduction_type_wise_report" parent="hr_payroll.menu_hr_payroll_report"
                  action="deduction_type_wise_report_action"/>
    </data>
</odoo>
