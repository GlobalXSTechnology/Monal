<odoo>
    <data>

        <record id="view_order_form_inherit_brand" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.brand</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                    <field name="brand_id"/>
                </xpath>
            </field>
        </record>


        <record id="list_view_brand_field" model="ir.ui.view">
            <field name="name">Product Brand</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <list>
                    <field name="product_name"/>
                    <field name="brand_name"/>
                </list>
            </field>
        </record>

        <record id="form_view_brand_field" model="ir.ui.view">
            <field name="name">Product Brand</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <label for="brand_name"/>
                        <h1>
                            <field name="brand_name" placeholder="BRAND NAME"/>
                        </h1>

                        <group>
                            <field name="product_name"/>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="action_pro_brand" model="ir.actions.act_window">
            <field name="name">Product Brand</field>
            <field name="res_model">product.brand</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_product_brand" name="Product Brands" action="action_pro_brand"
                  parent="stock.menu_stock_config_settings"/>
    </data>
</odoo>