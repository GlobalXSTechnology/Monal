<?xml version="1.2" encoding="utf-8"?>
<odoo>

    <record id="loan_type_view_form" model="ir.ui.view">
        <field name="model">loan.type</field>
        <field name="arch" type="xml">
            <form string="Record rules">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>


    <record id="loan_type_tree" model="ir.ui.view">
        <field name="model">loan.type</field>
        <field name="arch" type="xml">
            <list string="Record rules">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="action_loan_type_form" model="ir.actions.act_window">
        <field name="name">Loan Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">loan.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="loan_type_tree"/>
    </record>

    <menuitem id="loan_type_root"
              name="Loan Type"
              parent="hr.menu_human_resources_configuration"
              action="action_loan_type_form"
              sequence="10"
    />


</odoo>
