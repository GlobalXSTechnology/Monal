<odoo>
    <data>

        <record id="inherit_picking_form_accounting_date" model="ir.ui.view">
            <field name="name">inherit_picking_form_accounting_date</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='scheduled_date']" position="before">
                    <field name="accounting_date" invisible="not show_date"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
