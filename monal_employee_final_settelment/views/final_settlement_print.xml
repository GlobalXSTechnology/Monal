<odoo>


    <!-- addons/hr_final_settlement/views/report_final_settlement_letter.xml -->
    <template id="report_final_settlement_letter">
        <t t-call="web.external_layout">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <p style="text-align:right">
                            Date:
                            <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                        </p>
                        <p>
                            To,
                            <br/>
                            <br/>
                            <strong>
                                <strong>Mr/Ms.</strong>
                                <t t-esc="doc.name.name"/>
                            </strong>
                            <br/>
                            <br/>
                            City:
                            <t t-esc="doc.name.private_city"/>
                        </p>
                        <p>
                            Subject:
                            <strong>Final Settlement Letter</strong>
                        </p>
                        <p style="font-size: 16pt;">
                            We would like to take this opportunity to formally acknowledge and confirm the final
                            <br/>
                            settlement of your dues following the cessation of your employment with M/S the
                            <br/>
                            Monal Group as a
                            <t t-esc="doc.designation"/>
                            and last working date is
                            <t t-esc="doc.last_working_date"/>
                            .
                        </p>
                        <p style="font-size: 16pt;">After careful review, we have calculated the final settlement amount
                            based on the following:
                        </p>
                        <div style="margin-bottom: 10px;font-size: 16pt;">
                            <div>
                                Net Salary:  
                                <t t-esc="doc.net_salary_amount"/>
                            </div>
                            <div>
                                Bonus:    
                                <t t-esc="doc.bonus_amount"/>
                            </div>
                            <div>
                                Gratuity:   
                                <t t-esc="doc.gratuity_amount"/>
                            </div>
                            <div>Deductions:  
                                <t t-esc="doc.all_ded_amount"/>
                            </div>
                        </div>
                        <p style="font-size: 16pt;">
                            The above‑mentioned amount is paid to you in presence of witnesses.
                            <br/>
                            We kindly ask you to confirm your agreement with this final settlement by signing below.
                        </p>
                        <p style="font-size: 16pt;">
                            Yours sincerely,
                            <br/>
                            <br/>
                            <strong>HR Department</strong>
                            <br/>
                            M/S the Monal Group
                            <span style="float:right">Employee Signature: __________________</span>
                        </p>
                        <p style="padding: 15px;">
                            Witness: ______________________
                            <span style="float:right">Witness: _______________________</span>
                        </p>
                        <!--                     <hr style="border-top:1px dashed #000"/> -->
                        <br/>
                        <br></br>
                        <br></br>
                        <br></br>
                        <h4 style="text-align:center;">Acknowledgment</h4>
                        <p style="font-size: 16pt;">
                            I,
                            <strong>
                                <t t-esc="doc.name.name"/>
                            </strong>
                            , hereby confirm the receipt of the final settlement amount as detailed above and
                            acknowledge
                            that no further dues are outstanding from the Monal Group in any shape.
                        </p>
                        <p>
                            Signature: ______________________
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            Date:
                            <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                        </p>
                        <p>
                            Witness: ______________________
                            <span style="float:right">Witness: ______________________</span>
                        </p>
                    </div>
                    <div class="page">
                        <br/>
                        <br/>
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="width:20%;">
                                    <strong>Name:</strong>
                                </td>
                                <td style="width:30%;">
                                    <span t-out="doc.name.name"/>
                                </td>

                                <td style="width:20%;">
                                    <strong>Joining Date:</strong>
                                </td>
                                <td style="width:30%;">
                                    <span t-out="doc.jod"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Father Name:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.name.x_studio_father_name if 'x_studio_father_name' in doc.name._fields else ''"/>
                                </td>

                                <td>
                                    <strong>GRP Joining Date:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.name.contract_id.x_studio_group_joining_date"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Badge ID:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.batch"/>
                                </td>

                                <td>
                                    <strong>Gratuity Date:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.gratuity_date"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Department:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.department"/>
                                </td>

                                <td>
                                    <strong>Date of Birth:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.name.birthday"
                                          t-options='{"widget": "date"}'/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Designation:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.designation"/>
                                </td>

                                <td>
                                    <strong>Contract End Date:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.contract_end_date"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Identification No:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.name.identification_id"/>
                                </td>

                                <td>
                                    <strong>Worked Days:</strong>
                                </td>
                                <td>
                                    <span t-out="doc.count_days"/>
                                </td>
                            </tr>
                        </table>
