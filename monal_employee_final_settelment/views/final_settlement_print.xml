                        <h4 class="mt-4" style="margin-top:20px;">Salary Computation</h4>
                        <table class="table table-bordered" style="width:100%; border: 1px solid black;">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th style="text-align:left;">Description</th>
                                    <th style="text-align:left;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.payslip_line_ids">
                                    <t t-foreach="doc.payslip_line_ids" t-as="line">
                                        <tr t-if="line.total != 0">
                                            <td style="text-align:left;">
                                                <span t-out="line.name"/>
                                            </td>
                                            <td style="text-align:left;">
                                                <span t-out="line.total"
                                                      t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.name.company_id.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <h4 class="mt-4" style="margin-top:20px;">Employee Uniforms Details</h4>

                        <t t-if="doc.report_uniform_line_ids">
                            <table class="table table-bordered" style="width:100%;border: 1px solid black;">
                                <thead>
                                    <tr style="background-color: #eeeeee;">
                                        <th style="padding:5px">Ref No</th>
                                        <th>Distribution Date</th>
                                        <th>Uniform Product</th>
                                        <th>Check Filter</th>
                                        <th class="text-right">Actual Issued Qty</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.report_uniform_line_ids" t-as="ul">
                                        <tr>
                                            <td style="padding:5px">
                                                <span t-out="ul.uniform_id.name"/>
                                            </td>
                                            <td>
                                                <span t-out="ul.uniform_id.distribution_date"
                                                      t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                            </td>
                                            <td>
                                                <span t-out="ul.product_id.name"/>
                                            </td>
                                            <td>
                                                <span t-if="ul.check_filter == 'used'">Issue</span>
                                                <span t-if="ul.check_filter == 'return'">Return</span>
                                                <span t-if="ul.check_filter == 'new'">Replace</span>
                                            </td>
                                            <td class="text-right">
                                                <span t-out="ul.done_quantity"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No uniform records found for this employee in the last 6 months.</p>
                        </t>
                        <div style="margin-top: 20px;">
                            <p>
                                <strong>Department Head:</strong>
                                <span style="display: inline-block; margin-left: 08px; width: 150px; border-bottom: 1px solid black;"/>
                            </p>
                            <div>
                                <p>
                                    <strong>IT Signature:</strong>
                                    <span style="display: inline-block; margin-left: 50px; width: 150px; border-bottom: 1px solid black;"/>
                                </p>
                            </div>
                            <div>
                                <p>
                                    <strong>Store Signature:</strong>
                                    <span style="display: inline-block; margin-left: 26px; width: 150px; border-bottom: 1px solid black;"/>
                                </p>
                            </div>
                            <div>
                                <p>
                                    <strong>Admin Signature:</strong>
                                    <span style="display: inline-block; margin-left: 20px; width: 150px; border-bottom: 1px solid black;"/>
                                </p>
                            </div>
                            <div>
                                <p>
                                    <strong>Account Signature:</strong>
                                    <span style="display: inline-block; margin-left: 7px; width: 150px; border-bottom: 1px solid black;"/>
                                </p>

                            </div>
                        </div>

                        <div style="margin-top: 80px; width: 100%;">
                            <table style="width: 100%; text-align: center;">
                                <tr>
                                    <td style="width: 33%; padding: 0 20px;">
                                        <div style="border-top: 2px solid #000; padding-top: 8px;">
                                            GM
                                        </div>
                                    </td>
                                    <td style="width: 33%; padding: 0 20px;">
                                        <div style="border-top: 2px solid #000; padding-top: 8px;">
                                            HR Approval
                                        </div>
                                    </td>
                                    <td style="width: 33%; padding: 0 20px;">
                                        <div style="border-top: 2px solid #000; padding-top: 8px;">
                                            Employee Signature
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

