<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_print_payslip']" position="after">
                <button name="action_payslip_paid" class="btn btn-primary"
                        string="Mark as Paid" type="object" invisible="state != 'done'"/>
            </xpath>
            <xpath expr="//sheet[1]/group[1]/field[@name='payslip_run_id']" position="after">
<!--                <field name="emp_bank_name"/>-->
<!--                <field name="emp_acc_no"/>-->
                <field name="last_work_date"/>
                <field name="count_days"/>
            </xpath>
        </field>
    </record>
</odoo>