<odoo>
    <record id="view_stock_return_picking_form" model="ir.ui.view">
        <field name="name">transfer.consumption.form</field>
        <field name="model">transfer.consumption</field>
        <field name="inherit_id" ref="consumption.view_transfer_consumption_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="custom_analytic_distribution" widget="analytic_distribution" invisible="company_id != 28"/>
                <field name="company_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>