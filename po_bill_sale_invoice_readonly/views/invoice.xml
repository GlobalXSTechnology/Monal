<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='product_id']" position="after">
                <field name="sale_order_invoice" column_invisible="1"/>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='product_id']" position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='name']" position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='account_id']" position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='analytic_distribution']"
                   position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='quantity']" position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='product_uom_category_id']"
                   position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='product_uom_id']"
                   position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='discount']" position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='tax_ids']" position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='price_subtotal']"
                   position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='price_total']"
                   position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab'][1]/field[1]/list[1]/field[@name='partner_id']" position="attributes">
                <attribute name="readonly">sale_order_invoice</attribute>
            </xpath>
        </field>
    </record>

</odoo>