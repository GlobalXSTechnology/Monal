<odoo>
    <data>


        <record id="view_monal_salary_sheet_form_view" model="ir.ui.view">
            <field name="name">Salary Sheet Envelope </field>
            <field name="model">monal.salary.sheet</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="daily_wager"/>
                            <field name="date_from" invisible="not daily_wager"/>

                        </group>
                        <group>
                            <field name="archive"/>
                            <field name="filter_by"/>
                            <field name="company" invisible="filter_by != 'company'"/>
                            <field name="employee" widget="many2many_tags" invisible="filter_by != 'employee'"/>
                            <field name="analytic_ids" widget="many2many_tags" invisible="filter_by != 'analytic'"/>
                            <field name="department" widget="many2many_tags" invisible="filter_by != 'department'"/>
                            <field name="month" invisible="daily_wager"/>

<!--                            <field name="year" invisible="daily_wager"/>-->
                        </group>
                    </group>
                    <footer>
                        <button name="print_report" string="Proceed" type="object" class="btn-primary"/>
                        <button name="cancel" string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_monal_salary_sheet" model="ir.actions.act_window">
            <field name="name">Salary Sheet Envelope</field>
            <field name="res_model">monal.salary.sheet</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_monal_salary_sheet_form_view"/>
        </record>

        <menuitem id="menu_monal_salary_sheet" name="Salary Sheet Envelope" action="action_monal_salary_sheet"
                  parent="hr_payroll.menu_hr_payroll_report"/>

    </data>
</odoo>