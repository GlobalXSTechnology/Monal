<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="worker_daily_job_card_wizard_form" model="ir.ui.view">
        <field name="name">worker.daily.job.card.wizard</field>
        <field name="model">sync.adv.loan.update</field>
        <field name="arch" type="xml">
            <form string="Worker Wages Daily Job Card">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="installments"/>
                        <field name="amount"/>
                        <field name="salary_id" invisible="1"/>
                    </group>

                </group>
                <footer>
                    <button name="action" string="Change by number" type="object" class="btn-success" confirm="Are you Sure!"/>
                    <button name="by_amount" string="Change by amount" type="object" class="btn-success" confirm="Are you Sure!"/>
                    <button string="Cancel" class="btn-danger" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

