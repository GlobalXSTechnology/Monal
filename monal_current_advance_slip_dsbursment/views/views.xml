<odoo>
    <data>
        <!-- Employee Daily deduction Report -->
        <record model="ir.ui.view" id="monal_current_advance_slip_report_form">
            <field name="name">monal.current.advance.slip.disbursment</field>
            <field name="model">monal.current.advance.slip.disbursment</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="date_from" invisible="1"/>
                            <field name="date_to" invisible="1"/>
                            <field name="advance_type" invisible="0"/>
                        </group>
                        <group>
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <footer>
                        <button name="print_report_imp" string="Print Current Advance" type="object" class="btn-primary"/>
                        <button string="Close" class="btn-danger" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="monal_current_advance_slip_action_window">
            <field name="name">Current Advances Slip (Disbursment)</field>
            <field name="res_model">monal.current.advance.slip.disbursment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="monal_current_advance_slip_report_form"/>

        </record>


        <menuitem id="menu_current_advance_slip_disbursment"
                  name="Monal Current Advances Slip (Disbursment)"
                  parent="hr_payroll.menu_hr_payroll_report"
                  action="monal_current_advance_slip_action_window"
                  sequence="3"/>

    </data>
</odoo>
