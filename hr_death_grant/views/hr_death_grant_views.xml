<odoo>
    <!-- Action should come before it's used in menuitem -->
    <record id="action_hr_death_grant" model="ir.actions.act_window">
        <field name="name">Death Grant</field>
        <field name="res_model">hr.death.grant</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_death_grant_root" name="Employee Card" parent="hr.menu_hr_root"/>
    <menuitem id="menu_hr_death_grant" name="Death Grant Requests" parent="menu_hr_death_grant_root"
              action="action_hr_death_grant"/>

    <record id="view_death_grant_form" model="ir.ui.view">
        <field name="name">hr.death.grant.form</field>
        <field name="model">hr.death.grant</field>
        <field name="arch" type="xml">
            <form string="Death Grant Application">
                <header>
                    <button name="action_create_transfer"
                            type="object"
                            string="Create Payment"
                            class="btn-primary"
                            invisible="state != 'done' or payment_ready"
                    />


                    <button name="action_submit_for_approval" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve_done" type="object" string="Approve"
                            class="btn-success" invisible="state != 'approval'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approval,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_death_grant_payments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="employee_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="years_of_service" readonly="1"/>
                            <field name="deceased_relation"/>
                            <field name="basic_salary" readonly="1"/>

                        </group>
                        <group>
                            <field name="badge_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="joining_date" readonly="1"/>
                            <field name="actual_expenses"
                                   readonly="deceased_relation != 'employee'"/>
                            <field name="notes"/>
                        </group>

                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_death_grant_list" model="ir.ui.view">
        <field name="name">hr.death.grant.list</field>
        <field name="model">hr.death.grant</field>
        <field name="arch" type="xml">
            <list string="Death Grants">
                <field name="employee_id"/>
                <field name="deceased_relation"/>
                <field name="years_of_service"/>
                <field name="state"/>
                <field name="actual_expenses"/>
                <!--                <field name="eligible"/>-->
            </list>
        </field>
    </record>
    <record id="view_employee_form_inherit_death_grant_button" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.death.grant.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_death_grants"
                        type="object"
                        string="Death Grant"
                        class="oe_stat_button"
                        icon="fa-heartbeat">
                </button>
            </xpath>
        </field>
    </record>
    <record id="action_hr_death_grant_employee" model="ir.actions.act_window">
        <field name="name">Death Grants</field>
        <field name="res_model">hr.death.grant</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_employee_id': active_id}</field>
    </record>
    <!-- Death Policy Configuration -->
    <record id="action_hr_death_policy" model="ir.actions.act_window">
        <field name="name">Death Policies</field>
        <field name="res_model">hr.death.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_death_policy_root"
              name="Death Policy"
              parent="hr.menu_human_resources_configuration"
              sequence="50"/>


    <menuitem id="menu_hr_death_policy"
              name="Policies"
              parent="menu_hr_death_policy_root"
              action="action_hr_death_policy"/>

    <record id="view_hr_death_policy_form" model="ir.ui.view">
        <field name="name">hr.death.policy.form</field>
        <field name="model">hr.death.policy</field>
        <field name="arch" type="xml">
            <form string="Death Policy">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="department_ids" widget="many2many_tags" invisible="1"/>
                            <field name="department_id" widget="many2many_tags"
                                   domain="[('id', 'in', department_ids)]"/>
                        </group>
                        <group>

                            <field name="min_years_service"/>
                            <field name="grant_amount"/>
                            <field name="max_salary"/>
                        </group>

                    </group>
                </sheet>
            </form>
            <!--            <chatter/>-->

        </field>

    </record>

    <record id="view_hr_death_policy_list" model="ir.ui.view">
        <field name="name">hr.death.policy.list</field>
        <field name="model">hr.death.policy</field>
        <field name="arch" type="xml">
            <list string="Death Policies">
                <field name="name"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <field name="min_years_service"/>
                <field name="grant_amount"/>
            </list>
        </field>
    </record>

</odoo>
