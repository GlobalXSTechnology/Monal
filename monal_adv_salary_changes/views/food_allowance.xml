<odoo>
    <record id="inherit_food_alllowance" model="ir.ui.view">
        <field name="name">Inherit Food Allowance Form</field>
        <field name="model">food.allowances</field>
        <field name="inherit_id" ref="food_allowance.view_food_allowance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page/field[@name='food_line_template']/list/field[@name='employee_id']"
                   position="after">
                <field name="allowed_food_limit" invisible="0"/>
                <field name="food_deduction" invisible="0"/>
                <field name="working_days" invisible="0"/>
            </xpath>
        </field>
    </record>

</odoo>





