<odoo>
    <data>

        <record model="ir.ui.view" id="lock_date_form_view">
            <field name="name">Lock Date</field>
            <field name="model">lock.date</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="done_button" string="Approve" type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="reset_button" string="Reset to Draft" type="object" class="btn-primary"
                                invisible="state != 'done'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="lock_date" placeholder="Date" readonly="state != 'draft'"/>
                            </h1>
                        </div>
                        <group>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                    </sheet>
                    <chatter/>

                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="lock_date_list_view">
            <field name="name">Lock Date</field>
            <field name="model">lock.date</field>
            <field name="arch" type="xml">
                <list>
                    <field name="lock_date"/>
                    <field name="state"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="lock_date_action">
            <field name="name">Lock Date</field>
            <field name="res_model">lock.date</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="lock_date_rule_company" model="ir.rule">
            <field name="name">Lock Date - Company Rule</field>
            <field name="model_id" ref="model_lock_date"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <menuitem name="Lock Date" id="lock_date_menu_root" action="lock_date_action"
                  parent="hr_work_entry_contract_enterprise.menu_hr_payroll_configuration"/>

    </data>
</odoo>
