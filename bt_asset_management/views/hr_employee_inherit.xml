<odoo>


    <record id="view_employee_asset_move_button" model="ir.ui.view">
        <field name="name">hr.employee.asset.move.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_assets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-building">
                        <field name="asset_count" widget="statinfo"
                               string="Assets"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
  <record id="view_account_asset_tree_readonly" model="ir.ui.view">
        <field name="name">account.asset.tree.readonly</field>
        <field name="model">account.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="current_location"/>
                <field name="asset_loc_id"/>
            </list>
        </field>
    </record>
</odoo>