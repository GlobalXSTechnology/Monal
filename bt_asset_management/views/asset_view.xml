        <menuitem name="Asset Management"
                  id="asset_management_main_menu"
                  web_icon="bt_asset_management,static/src/img/icon.png"
                  sequence="100"
                  groups="bt_asset_management.group_asset_management_user_new,bt_asset_management.group_asset_management_manager"/>

