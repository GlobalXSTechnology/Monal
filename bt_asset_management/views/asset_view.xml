        <!-- Inherit Form View to Modify it -->
        <record id="asset_tree_inherit" model="ir.ui.view">
            <field name="name">asset.tree.inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <!-- Add your fields or attributes here -->
                    <attribute name="create">1</attribute>
                    <attribute name="edit">1</attribute>
                </xpath>

            </field>
        </record>
        <record id="asset_kanban_inherit" model="ir.ui.view">
            <field name="name">asset.kanban.inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <!-- Add your fields or attributes here -->
                    <attribute name="create">1</attribute>
                    <attribute name="edit">1</attribute>
                </xpath>

            </field>
        </record>
        <record id="asset_form_inherit" model="ir.ui.view">
            <field name="name">asset.form.inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <!--                <xpath expr="//header/button[@name='action_set_to_close']" position="attributes">-->
                <!--                    <attribute name="groups">account.group_account_user</attribute>-->
                <!--                </xpath>-->
                <xpath expr="//header/button[@name='set_to_draft']" position="attributes">
                    <attribute name="groups">account.group_account_user</attribute>
                </xpath>
                <xpath expr="//header/button[@name='set_to_running']" position="attributes">
                    <attribute name="groups">account.group_account_user</attribute>
                </xpath>
                <!--                <xpath expr="//header/button[@name='action_asset_pause']" position="attributes">-->
                <!--                    <attribute name="groups">account.group_account_user</attribute>-->
                <!--                </xpath>-->
                <xpath expr="//header/button[@name='resume_after_pause']" position="attributes">
                    <attribute name="groups">account.group_account_user</attribute>
                </xpath>
                <xpath expr="//header/button[@name='action_asset_modify']" position="attributes">
                    <attribute name="groups">account.group_account_user</attribute>
                </xpath>
                <xpath expr="//header/button[@name='action_save_model']" position="attributes">
                    <attribute name="groups">account.group_account_user</attribute>
                </xpath>

                <xpath expr="//form" position="attributes">
                    <!-- Add your fields or attributes here -->
                    <attribute name="create">1</attribute>
                    <attribute name="edit">1</attribute>
                </xpath>

            </field>
        </record>


