                id="asset_managment_main_submenu"
                parent="asset_management_main_menu"
                sequence="101"
                name="Asset Managements"
        />


        <record model="ir.ui.view" id="my_inherited_module">
            <field name="name">Inherited form</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='original_value']" position="after">
                    <field name="current_location"/>
                </xpath>
                <xpath expr="//field[@name='original_value']" position="after">
                    <field name="current_cost"/>
                </xpath>
                <xpath expr="//field[@name='current_cost']" position="after">
                    <field name="accumulated_depreciation"/>
                </xpath>
                <xpath expr="//field[@name='model_id']" position="after">
                    <field name="asset_minor_cat"
                           options="{'no_quick_create': False, 'no_create_edit': False}"/>
                </xpath>
                <xpath expr="//group[1]//div['salvage_value_pct']" position="after">
                    <field name="asset_type_id"/>
                </xpath>
                <xpath expr="//field[@name='salvage_value']" position="after">
                    <field name="condition"/>
                </xpath>
                <xpath expr="//field[@name='condition']" position="after">
                    <field name="is_serviceable"/>
                </xpath>

                <xpath expr="//field[@name='model_id']" position="after">

                    <!-- Hidden control fields -->
                    <field name="it_check" invisible="1"/>
                    <field name="vehicle_check" invisible="1"/>
                    <field name="weapon_check" invisible="1"/>

                    <!-- IT Fields -->
                    <field name="storage" invisible="it_check == False"/>
                    <field name="ram" invisible="it_check == False"/>
                    <field name="display_size" invisible="it_check == False"/>

                    <!-- Vehicle Fields -->
                    <field name="registration_no" invisible="vehicle_check == False"/>
                    <field name="engine_no" invisible="vehicle_check == False"/>
                    <field name="chassis_no" invisible="vehicle_check == False"/>

                    <!-- Weapon Fields -->
                    <field name="body_no" invisible="weapon_check == False"/>

                </xpath>


                <!--                <xpath expr="//field[@name='model_id']" position="after">-->
                <!--                    <field name="it_check" invisible="1"/>-->
                <!--                    <field name="storage" invisible="it_check == False"/>-->
                <!--                    <field name="ram" invisible="it_check == False"/>-->
                <!--                    <field name="display_size" invisible="it_check == False"/>-->

                <!--                    <field name="it_check" invisible="1"/>-->
                <!--                    <field name="registration_no" invisible="vehicle_check == False"/>-->
                <!--                    <field name="engine_no" invisible="vehicle_check == False"/>-->
                <!--                    <field name="chassis_no" invisible="vehicle_check == False"/>-->

                <!--                    <field name="it_check" invisible="1"/>-->
                <!--                    <field name="body_no" invisible="weapon_check == False"/>-->
                <!--                </xpath>-->


                <xpath expr="//page[2]" position="after">
                    <page string="Asset Information">
                        <group>
                            <group>
                                <field name="asset_code"/>
                                <field name="serial_no"/>
                                <field name="asset_make"/>
                                <field name="model_name"
                                       options="{'no_create_edit':True,'no_create':True,'no_open': True}"/>
                            </group>
                            <group>
                                <field name="manufacturer"/>
                                <field name="warranty_start"/>
                                <field name="warranty_end"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <!--                <field expr="//field[@name='category_id']" position="after">-->
                <!--                    <field name="current_loc_id"/>-->
                <!--                </field>-->
                <xpath expr="//page[3]" position="after">
                    <page string="Notes">
                        <field name="note"/>
                    </page>
                </xpath>
                <field name="salvage_value" position="before">
                    <field name="asset_loc_id"/>
                </field>
                <field name="asset_loc_id" position="after">
                    <field name="asset_code"/>
                </field>
                <field name="asset_loc_id" position="after">
                    <field name="hr_no"/>
                    <field name="designation" domain="[('department_id', '=', user_department)]"/>
                    <field name="user_department"/>
                </field>
            </field>
        </record>


