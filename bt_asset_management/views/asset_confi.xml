<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_confi_tree" model="ir.ui.view">
        <field name="name">view.confi.tree</field>
        <field name="model">bt.con</field>
        <field name="arch" type="xml"> <list multi_edit="1">
                <field name="Model_na"/>

</list>
        </field>
    </record>



    <record id="configuration_bt_form" model="ir.ui.view">
        <field name="name">configuration.bt.form</field>
        <field name="model">bt.con</field>
        <field name="arch" type="xml">
            <form>
            <group>
                <field name="Model_na"/>
            </group>
            </form>
        </field>
    </record>

    <record id="action_bt_con" model="ir.actions.act_window">
        <field name="name">Model Name</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bt.con</field>
        <!--	            <field name="view_type">form</field>-->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Model Name
            </p>
        </field>
    </record>

    <menuitem id="menu_action_bt_con" parent="asset_management_main_menu"
              action="action_bt_con" name="Model Name"
              sequence="112"/>

