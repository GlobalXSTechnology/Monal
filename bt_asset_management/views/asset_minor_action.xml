<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_minor_category_list" model="ir.ui.view">
        <field name="name">asset.minor.category.list</field>
        <field name="model">asset.minor.category</field>
        <field name="arch" type="xml">
            <list string="Asset Minor Categories">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_asset_minor_category_form" model="ir.ui.view">
        <field name="name">asset.minor.category.form</field>
        <field name="model">asset.minor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. IT Equipment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_minor_category" model="ir.actions.act_window">
        <field name="name">Asset Minor Categories</field>
        <field name="res_model">asset.minor.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Asset Minor Category
            </p>
        </field>
    </record>

    <menuitem id="menu_asset_minor_category"
              name="Asset Minor Categories"
              parent="account.menu_finance_configuration"
              action="action_asset_minor_category"
              sequence="50"/>
</odoo>