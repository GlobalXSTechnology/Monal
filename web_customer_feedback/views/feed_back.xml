<odoo>
    <data>
        <record id="monal_customer_feedback_view_list" model="ir.ui.view">
            <field name="name">monal.customer.feedback.list</field>
            <field name="model">monal.customer.feedback</field>
            <field name="arch" type="xml">
                <list string="MONAL Customer Feedback Records">
                    <field name="name"/>
                    <field name="website_id"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>


        <record id="monal_customer_feedback_view_form" model="ir.ui.view">
            <field name="name">monal.customer.feedback.form</field>
            <field name="model">monal.customer.feedback</field>
            <field name="arch" type="xml">
                <form string="MONAL Customer Feedback Records">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="website_id"/>
                            <field name="page_url"/>
                            <field name="thank_you_url"/>
                            <field name="qr_code_url"/>
                        </group>
                        <group>
                            <field name="qr_code" widget="image" options="{'size': [200, 200]}"/>
                            <button name="action_download_qr_code" type="object" string="Download QR Code" class="oe_highlight" icon="fa-download" invisible="not qr_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer Feedback">
                            <field name="lines_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="value" widget="radio" options="{'horizontal': true}"/>
                                </list>
                            </field>
                            <group>
                                <field name="remarks" widget="html"/>
                             </group>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="monal_monal_customer_feedback_action_window">
            <field name="name">MONAL Customer Feedback Records</field>
            <field name="res_model">monal.customer.feedback</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="monal_customer_feedback_view_list"/>
        </record>


        <menuitem id="menu_monal_customer_feedback_view_form_menu"
                  name="Feedback Template"
                  parent="point_of_sale.menu_point_config_product"
                  action="monal_monal_customer_feedback_action_window"
                  sequence="14"/>

        <record id="customer_feedback_view_list" model="ir.ui.view">
            <field name="name">customer.feedback.form</field>
            <field name="model">customer.feedback</field>
            <field name="arch" type="xml">
                <list string="Customer Feedback">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="contact_number"/>
                    <field name="address"/>
                    <field name="create_date" string="Feedback Date"/>
                    <field name="date_birth"/>
                    <field name="anniversary"/>
                    <field name="excelent_count"/>
                    <field name="good_count"/>
                    <field name="average_count"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="website_id"/>
                </list>
            </field>
        </record>


        <record id="customer_feedback_view_form" model="ir.ui.view">
            <field name="name">customer.feedback.form</field>
            <field name="model">customer.feedback</field>
            <field name="arch" type="xml">
                <form string="Customer Feedback">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="contact_number"/>
                            <field name="address"/>
                            <field name="remarks"/>
                        </group>
                        <group>
                            <field name="create_date" string="Feedback Date" readonly="1"/>
                            <field name="date_birth"/>
                            <field name="anniversary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="website_id" groups="website.group_website_designer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Feedback">
                            <field name="customer_feedback_lines_id">
                                <list editable="bottom">
                                    <field name="question"/>
                                    <field name="value" widget="radio" options="{'horizontal': true}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="customer_feedback_view_search" model="ir.ui.view">
            <field name="name">customer.feedback.search</field>
            <field name="model">customer.feedback</field>
            <field name="arch" type="xml">
                <search string="Customer Feedback Search">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="contact_number"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="website_id" groups="website.group_website_designer"/>
                    <filter string="My Company" name="my_company" domain="[('company_id', '=', context.get('company_id', False))]"/>
                    <filter string="This Website" name="this_website" domain="[('website_id', '=', context.get('website_id', False))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                        <filter string="Website" name="group_website" context="{'group_by': 'website_id'}"/>
                        <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record model="ir.actions.act_window" id="customer_feedback_action_window">
            <field name="name">Customer Feedback</field>
            <field name="res_model">customer.feedback</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="customer_feedback_view_list"/>
            <field name="domain">[]</field>
            <field name="context">{
                'search_default_company_id': context.get('default_company_id'),
                'default_company_id': context.get('default_company_id'),
            }</field>
        </record>


        <menuitem id="customer_feedback_view_menu"
                  name="Customer Feedback"
                  parent="point_of_sale.menu_point_config_product"
                  action="customer_feedback_action_window"
                  sequence="12"/>

    
    </data>
</odoo>
