            <!-- Clear form fields on page reload after submission -->
            <script>
                (function() {
                const urlParams = new URLSearchParams(window.location.search);
                if (!urlParams.has('submitted')) {
                return;
                }

                function clearForm() {
                const form = document.querySelector('form[action="/customer/feedback/submit"]');
                if (!form) return;

                // Method 1: Reset the form
                form.reset();

                // Method 2: Clear each field individually after reset
                const fields = ['name', 'email', 'contact_number', 'date_birth', 'anniversary', 'address'];
                fields.forEach(function(fieldName) {
                const input = form.querySelector('input[name="' + fieldName + '"]');
                if (input) {
                input.value = '';
                input.setAttribute('value', '');
                input.removeAttribute('value');
                }
                });

                // Clear radio buttons
                form.querySelectorAll('input[type="radio"]').forEach(function(radio) {
                radio.checked = false;
                radio.removeAttribute('checked');
                });
                }

                // Run immediately
                clearForm();

                // Run again after autofill
                setTimeout(clearForm, 100);
                setTimeout(clearForm, 500);

                // Clean URL
                urlParams.delete('submitted');
                const newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
                window.history.replaceState({}, '', newUrl);
                })();
            </script>

