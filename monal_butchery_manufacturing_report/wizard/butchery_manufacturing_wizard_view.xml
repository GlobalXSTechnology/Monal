<odoo>
    <record id="butchery_manufacturing_report_wizard" model="ir.ui.view">
        <field name="name">butchery.manufacturing.report.wizard</field>
        <field name="model">butchery.manufacturing.report</field>
        <field name="arch" type="xml">
            <form string="Butchery Manufacturing Report">

                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>

                    </group>
                    <group>
                        <field name="product_id"/>
                        <field name="categ_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_manufacturing_report" string="Print Manufacturing Report"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_butchery_manufacturing_report" model="ir.actions.act_window">
        <field name="name">Butchery Manufacturing Report</field>
        <field name="res_model">butchery.manufacturing.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="butchery_manufacturing_report_wizard"/>
    </record>

<!--    <menuitem id="menu_butchery_report_root2"-->
