            <!--                        <h2 style="margin:0; font-size:20px; font-weight:bold; line-height:1;">-->
            <!--                            <t t-esc="company.name"/>-->
            <!--                        </h2>-->
            <!--                    </div>-->

            <!--                    <div style="flex:1; text-align:right; font-size:12px; line-height:1.4; display:flex; align-items:center; justify-content:flex-end;">-->
            <!--                        <p style="margin:0; line-height:1.3;">-->
            <!--                            <t t-esc="company.partner_id.street"/>-->
