<odoo>
    <data>
        <!-- Employee Daily deduction Report -->
        <record model="ir.ui.view" id="monal_employee_deduction_report_form">
            <field name="name">monal.deduction.report.employee</field>
            <field name="model">monal.deduction.report.employee</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="period"/>
<!--                            <field name="from_date"/>-->
                            <field name="mode_type"/>
                            <field name="rule_domain_ids" widget="many2many_tags" invisible="1"/>
                            <field name="deduction_rule_ids" widget="many2many_tags"/>
                        </group>
                        <group>
<!--                            <field name="to_date"/>-->
                            <field name="company_id" invisible="mode_type != 'company'"/>
                            <field name="department_ids" widget="many2many_tags" invisible="mode_type != 'department'"/>
                            <field name="employee_ids" widget="many2many_tags" invisible="mode_type != 'employee'"/>
                            <field name="section_ids" widget="many2many_tags" invisible="1"/>
                            <field name="salary_structure_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="print_report_imp" string="Print Deduction" type="object" class="btn-primary"/>
                        <button string="Close" class="btn-danger" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="monal_employees_deduction_action_window">
            <field name="name">Employees Monthly Deduction</field>
            <field name="res_model">monal.deduction.report.employee</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="monal_employee_deduction_report_form"/>

        </record>


        <menuitem id="menu_deduction_employees_daily"
                  name="Monal Employees Monthly Deduction"
                  parent="hr_payroll.menu_hr_payroll_report"
                  action="monal_employees_deduction_action_window"
                  sequence="3"/>

    </data>
</odoo>
