<odoo>
    <data>
        <template id="print_deduction_report_employee">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="header" style="border-bottom: 1px solid black;">
                        <div class="row" height="10px">
                            <div class="col-8">
                                <h5 style="text-align: left">
                                    <b t-field="res_company.name"/>
                                </h5>
                                <h6 style="text-align: left">
                                    <span>Employee Deduction Register</span>
                                </h6>
                            </div>
                            <div class="col-4" style="text-align:right;">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" width="100px" height="60px"/>
                            </div>
                        </div>
                    </div>
                    <div class="page">
                        <t t-set="counter" t-value="0"/>
                        <table class="table table-sm" style="width:100%; font-size: 10px; border: 1px solid black">
                            <thead>
                                <tr style="background: #C1C1C1;  border: 1px solid black">
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Sr No</strong>
                                    </th>

                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Doc #</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Doc Date</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Emp Code</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Emp Name</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Father Name</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>CNIC</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>DOB</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Department</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Designation</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Sr #</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Line Type</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Deduction Amount</strong>
                                    </th>
                                    <th style=" border: 1px solid black" class="text-center">
                                        <strong>Remarks</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="border: 1px solid black">
                                <t t-set="counter" t-value="counter + 1"/>
                                <tr style="border: 1px solid black" t-foreach="all_datas" t-as="line">
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="counter"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('doc_no')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('doc_date')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('emp_code')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('emp_name')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('father_name')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('cnic')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('dob')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('department')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('designation')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('sr_no')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('line_type')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('deduction_amount')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('remarks')"/>
                                    </td>
                                </tr>
                                <tr style="border: 2px solid black; font-weight: bold; background: #f0f0f0;">
                                    <td colspan="11" class="text-center" style="padding-right:10px;">Total Deductions
                                    </td>
                                    <td class="text-center" style="border: 2px solid black;">
                                        <span t-esc="'{0:,.2f}'.format(round(total_deductions,2))"/>
                                    </td>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
