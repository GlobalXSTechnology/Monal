<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_emp_att_deduction_list" model="ir.ui.view">
        <field name="name">emp.attendance.deduction.list</field>
        <field name="model">emp.attendance.deduction</field>
        <field name="arch" type="xml">
            <list string="Attendance Deductions">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_emp_att_deduction_form" model="ir.ui.view">
        <field name="name">emp.attendance.deduction.form</field>
        <field name="model">emp.attendance.deduction</field>
        <field name="arch" type="xml">
            <form string="Attendance Deductions">
                 <header>
                      <button name="action_draft" type="object" string="Reset to Draft"  invisible="state in ['draft', 'approve']"/>
                        <button name="action_approved" type="object" string="Approved" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_refused" type="object" string="Refused" class="btn-primary"
                                invisible="state in ['refused']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group string="Attendance Deductions">
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>



    <record id="action_view_emp_att_deduction" model="ir.actions.act_window">
        <field name="name">Attendance Deductions</field>
        <field name="res_model">emp.attendance.deduction</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the First Employee Date here.
            </p>
        </field>
    </record>


    <menuitem
            id="menu_emp_att_deduction"
            name="Attendance Deductions"
            parent="hr_attendance.menu_hr_attendance_view_attendances"
            action="action_view_emp_att_deduction"
            sequence='100'/>
</odoo>
