<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_landscape_employee_report" model="report.paperformat">
        <field name="name">Employee Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">55</field>
        <field name="dpi">90</field>
    </record>

    <template id="employee_report" name="employee_report">
        <t t-call="web.html_container">
            <t t-foreach="employee_ids" t-as="employee">
                <t t-set="company" t-value="env.company"/>
                <t t-call="web.external_layout" t-lang="en_US">
                    <div class="page">

                        <div class="col-12">
                            <div class="row">
                                <div class="col-10">
                                    <h1 style="text-align: center;">Attendance Report</h1>
                                    <!--                                    <h3>Employee: <t t-esc="employee['name']"/></h3>-->
                                    <!--                                    <h4>Title: <t t-if="employee['job_title']" t-esc="employee['job_title']"/></h4>-->
                                    <!--                                    <h4>Shift: <t t-if="employee['resource_calendar_id']" t-esc="employee['resource_calendar_id'][1]"/></h4>-->
                                </div>
                                <div class="col-2">
                                    <t t-set="image" t-value="employee_image(employee['id'])"/>
                                    <img class="text-right" style="float: right;" t-if="image"
                                         t-att-src="image_data_uri(image)" height="150" width="120"/>
                                </div>
                            </div>
                        </div>
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Name</th>
                                    <th>Department</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Worked Hours</th>
                                    <th>Late Minutes</th>
                                    <th>Overtime</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_late" t-value="0"/>
                                <t t-set="total_worked" t-value="0"/>
                                <t t-set="total_overtime" t-value="0"/>
                                <t t-foreach="lines(employee['id'], data).items()" t-as="item">
                                    <!--                                    <t t-set="total_late" t-value="total_late + item[1].get('late_minutes', 0)"/>-->
                                    <!--                                    <t t-set="total_worked" t-value="total_worked + item[1].get('worked_hours', 0)"/>-->
                                    <!--                                    <t t-set="total_overtime" t-value="total_overtime + item[1].get('overtime', 0)"/>-->
                                    <t t-set="total_late" t-value="total_late + (item[1].get('late_minutes') or 0)"/>
                                    <t t-set="total_worked"
                                       t-value="total_worked + (item[1].get('worked_hours') or 0)"/>
                                    <t t-set="total_overtime"
                                       t-value="total_overtime + (item[1].get('overtime') or 0)"/>
                                    <tr>
                                        <td nowrap="nowrap">
                                            <t t-esc="item[0]"/>
                                            -
                                            <t t-esc="dayofweek(item[0])"/>
                                        </td>
                                        <!-- Name (Employee Name + Badge) -->
                                        <td nowrap="nowrap">
                                            <t t-if="employee.get('barcode')">
                                                (<t t-esc="employee.get('barcode')"/>)
                                            </t>
                                            <t t-esc="employee['name']"/>
                                            <t t-if="employee.get('job_title')">
                                                (<t t-esc="employee.get('job_title')"/>)
                                            </t>
                                            <t t-if="employee.get('resource_calendar_id')">
                                                (<t t-esc="employee.get('resource_calendar_id')"/>)
                                            </t>

                                        </td>
                                        <!-- Department -->
                                        <td nowrap="nowrap">
                                            <t t-if="employee.get('department_id')">
                                                <t t-esc="employee['department_id'][1]"/>
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                        <t t-if="item[1].get('employee_id',False)"> <!-- Check if there is attendance data for this date -->
                                            <td nowrap="nowrap">
                                                <t t-esc="item[1].get('check_in', '-')"/>
                                            </td>
                                            <td nowrap="nowrap">
                                                <t t-esc="item[1].get('check_out', '-')"/>
                                            </td>
                                            <td nowrap="nowrap">
                                                <t t-esc="item[1].get('worked_hours', 0.0)"
                                                   t-options="{'widget': 'float_time'}"/>
                                            </td>
                                            <td nowrap="nowrap">
                                                <t t-esc="item[1].get('late_minutes', 0)"/>
                                            </td>
                                            <td nowrap="nowrap">
                                                <t t-esc="item[1].get('overtime', 0.0)"
                                                   t-options="{'widget': 'float_time'}"/>
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td colspan="5" class="text-center">
                                                <t t-esc="absence_str(employee['id'], item[0])"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                                <tr>
                                    <td colspan="3" class="text-center">Total</td>
                                    <td class="text-center">
                                        <t t-esc="total_worked" t-options="{'widget': 'float_time'}"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-esc="total_late"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-esc="total_overtime" t-options="{'widget': 'float_time'}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_employee_report" model="ir.actions.report">
        <field name="name">Employee Report</field>
        <field name="model">softatt_attendance.employee_report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">softatt_attendance.employee_report</field>
        <field name="report_file">softatt_attendance.employee_report</field>
        <field name="paperformat_id" ref="softatt_attendance.paperformat_landscape_employee_report"/>
        <field name="print_report_name">Employee Report</field>
    </record>

</odoo>
