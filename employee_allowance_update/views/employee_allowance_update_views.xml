<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= list View ================= -->
    <record id="view_employee_allowance_update_list" model="ir.ui.view">
        <field name="name">employee.allowance.update.list</field>
        <field name="model">employee.allowance.update</field>
        <field name="arch" type="xml">
            <list string="Employee Allowance Updates">
                <field name="name" string="Reference"/>
                <field name="select_type"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
                <field name="write_date" string="Last Updated"/>
            </list>
        </field>
    </record>

    <!-- ================= Form View ================= -->
    <record id="view_employee_allowance_update_form" model="ir.ui.view">
        <field name="name">employee.allowance.update.form</field>
        <field name="model">employee.allowance.update</field>
        <field name="arch" type="xml">
            <form string="Employee Allowance Update">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,created,approved"/>

                    <!-- Create Button - Only for Manager -->
                    <button name="action_create"
                            type="object"
                            string="Create Apply Allowances"
                            class="btn-primary"
                            groups="employee_allowance_update.group_allowance_update_manager"/>

                    <!-- Approve Button - Only for Approver -->
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-success"
                            groups="employee_allowance_update.group_allowance_update_approver"/>

                    <!-- Reset Button - Only for Manager -->
                    <button name="action_set_to_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                         />

                    <!-- Cancel Button - Only for Manager -->

                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Reference"/>
                            <field name="select_type"/>
                            <field name="company_id" invisible="select_type != 'company'"/>
                            <field name="department_ids" widget="many2many_tags"
                                   invisible="select_type != 'department'"/>
                            <field name="employee_ids" widget="many2many_tags" invisible="select_type != 'employee'"/>
                        </group>
                        <group>
                            <!--                            <label string="Employee Summary"/>-->
                            <div>
                                <field name="total_employees" widget="statinfo" string="Total Employees" nolabel="1"/>
                                <field name="employees_with_active_contracts" widget="statinfo"
                                       string="With Active Contracts" nolabel="1"/>
                            </div>
                        </group>
                    </group>

                    <separator string="Allowance Details"/>

                    <group col="4">
                        <field name="resident_allowance"/>
                        <field name="realocation"/>
                        <field name="bike"/>
                        <field name="car_maintence"/>
                        <field name="house"/>
                        <field name="car_allowance"/>
                        <field name="mobile_allowance"/>
                        <field name="miscellaneous_allowance"/>
                        <field name="fuel_allowance_cash_1"/>
                        <field name="allow_food_allowance"/>
                        <field name="food_allowance"/>
                        <field name="gun_allowance"/>
                        <field name="hill"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ================= Action ================= -->
    <record id="action_employee_allowance_update" model="ir.actions.act_window">
        <field name="name">Employee Allowance Updates</field>
        <field name="res_model">employee.allowance.update</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Employee Allowance Update record
            </p>
        </field>
    </record>

    <!-- ================= Menu Item ================= -->
    <menuitem id="menu_employee_allowance_update_root"
              name="Employee Allowance Updates"
              parent="hr.menu_hr_root"
              action="action_employee_allowance_update"
              sequence="100"/>
</odoo>