<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_department_form" model="ir.ui.view">
        <field name="name">hr.department.form</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="opening_count" readonly="opening_count_check"/>
                <field name="head_count_employee" readonly="1"/>
                <field name="head_count_employee" invisible="1"/>
                <field name="opening_budget" widget='monetary' readonly="opening_budget_check"/>
                <field name="budget" widget="monetary" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>