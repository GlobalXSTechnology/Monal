<odoo>
    <data>

        <record model="ir.ui.view" id="monal_employee_att_report_with_break_form">
            <field name="name">monal.attendance.report.employee.break</field>
            <field name="model">monal.attendance.report.employee.break</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="select_employee"/>
                            <field name="company_id" invisible="select_employee != 'company'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="department_id" widget="many2many_tags"
                                   invisible="select_employee != 'department'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="employee_ids" widget="many2many_avatar_user"
                                   invisible="select_employee != 'employee'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="show_time_filter" widget="boolean_toggle"/>
                            <field name="check_in_time" widget="time_dropdown"
                                   invisible="show_time_filter == False"/>
                            <field name="check_out_time" widget="time_dropdown"
                                   invisible="show_time_filter == False"/>
                            <field name="source_filter"/>

                        </group>
                        <group class="col-6">

                            <field name="status_filter"/>
                            <field name="work_hours_filter"
                                   invisible="status_filter != 'Work_hours'"/>
                            <field name="from_date"/>
                            <field name="to_date"/>
                        </group>

                    </group>
                    <footer>
                        <button name="print_report_imp" string="Print Attendance" type="object"
                                class="btn btn-success"/>
                        <button string="Close" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="monal_employees_attendance_with_break_action_window">
            <field name="name">Employees Monthly Attendance</field>
            <field name="res_model">monal.attendance.report.employee.break</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="monal_employee_att_report_with_break_form"/>

        </record>


        <menuitem id="menu_hr_attendance_employees_daily_with_break"
                  name="Monal Employees Monthly Attendance With Break"
                  parent="hr_attendance.menu_hr_attendance_reporting"
                  action="monal_employees_attendance_with_break_action_window"
                  sequence="2"/>

    </data>
</odoo>
