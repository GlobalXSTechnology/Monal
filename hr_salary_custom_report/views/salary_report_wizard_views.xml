<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_salary_report_wizard_form" model="ir.ui.view">
            <field name="name">salary.sheet.report.wizard.form</field>
            <field name="model">salary.sheet.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Salary Sheet Report">
                    <sheet>
                    <group>
                        <group>
                            <field name="archive"/>
                            <field name="select_employee"/>
                            <field name="company_id" invisible="select_employee != 'company'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="analytic_ids" widget="many2many_tags" invisible="select_employee != 'analytic'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="department_id" widget="many2many_tags"
                                   invisible="select_employee != 'department'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="employee_ids" widget="many2many_avatar_user"
                                   invisible="select_employee != 'employee'" options="{'no_create': True, 'no_create_edit': True}"/>

                        </group>
                        <group class="col-6">

                           <field name="period" required="1"/>
                        </group>

                    </group>
                    </sheet>
                    <footer>
                        <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                        <button string="Export Excel"
                            name="action_export_excel"
                            type="object"
                            class="btn-success"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard -->
        <record id="action_open_salary_report_wizard" model="ir.actions.act_window">
            <field name="name">Salary Sheet Report</field>
            <field name="res_model">salary.sheet.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_salary_report_wizard_form"/>
        </record>
         <menuitem
            id="menu_hr_salary_reports"
            name="Salary Reports"
            parent="hr_payroll.menu_hr_payroll_report"
            sequence="10"
        />

        <menuitem
            id="menu_salary_sheet_report"
            name="Salary Sheet Report"
            parent="menu_hr_salary_reports"
            sequence="10"
            action="action_open_salary_report_wizard"
        />
    </data>
</odoo>
