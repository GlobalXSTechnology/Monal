<odoo>
    <record id="advance_salary_form_inherit" model="ir.ui.view">
        <field name="name">hr.advance.salary.extand</field>
        <field name="model">hr.advance.salary</field>
        <field name="inherit_id" ref="sync_employee_advance_salary.hr_employee_advance_salary_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[4]" position="after">
                <button name="action_paid_2" type="object" class="oe_highlight" string="Payments"
                        invisible="state != 'deputy_cfo' or special_approval"/>
                <button name="action_paid_2" type="object" class="oe_highlight" string="Payments"
                        invisible="state != 'ceo' or not special_approval"/>
                <button name="action_paid_2" type="object" class="oe_highlight" string="Payments"
                        invisible="state != 'gm_finance'"/>
            </xpath>

        </field>
    </record>

    <record id="fields_added_contact_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.new</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_payable_id']" position="after">
                <field name="advance_receivable1"/>

                <field name="loan_receivable_pf"/>
                <!-- <field name="loan_receivable1_comp"/> -->
                <!-- <field name="loan_receivable1_vehicle"/> -->
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="view_advance_salery_form">
        <field name="name">advance.salary.payment.form</field>
        <field name="model">advance.salary.payment</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Employee Advance Salary">
                <sheet>
                    <group>
                        <group>
                            <field name="check" invisible="1"/>
                            <field name="debit_account" invisible="not check"/>
                            <field name="credit_account" invisible="check"/>
                            <field name="account_id1"/>
                            <field name="active_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="date"/>

                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_paid_3" type="object" string="Payments Post" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="account_form_smartbutton" model="ir.ui.view">
        <field name="name">ahr.advance.salary.smartbutton</field>
        <field name="model">hr.advance.salary</field>
        <field name="inherit_id" ref="sync_employee_advance_salary.hr_employee_advance_salary_view_form"/>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_journal_voucher"
                        class="oe_stat_button"
                        icon="fa-clipboard"
                        type="object" invisible="state != 'paid'">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"></span>
                        <span class="o_stat_text">Vouchers</span>
                    </div>
                </button>
                <button name="action_lum_sum"
                        class="oe_stat_button"
                        icon="fa-clipboard"
                        type="object" invisible="state != 'done'">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"></span>
                        <span class="o_stat_text">LumSum</span>
                    </div>
                </button>
            </div>

            <xpath expr="//button[@class='oe_stat_button'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- <xpath expr="//button[4]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
        </field>
    </record>

</odoo>
