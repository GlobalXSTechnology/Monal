<odoo>
    <data>
        <template id="print_facility_register_employee">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="header" style="border-bottom: 1px solid black;">
                        <div class="row" height="10px">
                            <div class="col-8">
                                <h5 style="text-align: left">
                                    <b t-field="res_company.name"/>
                                </h5>
                                <h6 style="text-align: left">
                                    <span>Employee Facility Register</span>
                                </h6>
                            </div>
                            <div class="col-4" style="text-align:right;">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" width="100px"
                                     height="60px"/>
                            </div>
                        </div>
                    </div>
                    <div class="page">
                        <t t-set="counter" t-value="0"/>
                        <table class="table table-sm" style="width:100%; font-size: 10px; border: 1px solid black">
                            <thead>
                                <tr style="background: #C1C1C1; border: 1px solid black;">
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Doc #</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Doc Date</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Emp Code</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Emp Name</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Reference</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Department</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Designation</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Sr #</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Method</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Facility Desc</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Qty</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Facility Amount</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" colspan="4">
                                        <strong>Reference</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center" rowspan="2">
                                        <strong>Remarks</strong>
                                    </th>
                                </tr>
                                <tr style="background: #E6E6E6; border: 1px solid black;">
                                    <th style="border: 1px solid black;" class="text-center">
                                        <strong>Method</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center">
                                        <strong>Doc Date</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center">
                                        <strong>Doc No</strong>
                                    </th>
                                    <th style="border: 1px solid black;" class="text-center">
                                        <strong>Qty</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="border: 1px solid black">
                                <t t-set="counter" t-value="counter + 1"/>
                                <tr style="border: 1px solid black" t-foreach="all_datas" t-as="line">
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('ref_no')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('distribution_date')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('emp_code')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('emp_name')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('ref_no')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('department')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('designation')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('sr')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('method')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('product')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('quantity')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('total_price')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('method_return')"/>
                                    </td>
                                    <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('return_date')"/>
                                    </td>
                                     <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('return_doc_no')"/>
                                    </td>
                                     <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('return_qty')"/>
                                    </td>
                                     <td class="text-center" style="border: 1px solid black">
                                        <span t-esc="line.get('remarks')"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
