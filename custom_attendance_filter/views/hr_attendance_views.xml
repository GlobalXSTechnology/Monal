<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_filter_inherit_23h" model="ir.ui.view">
        <field name="name">hr.attendance.search.inherit.23h</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='errors']" position="attributes">
                <attribute name="domain">['|', ('worked_hours', '&gt;=', 23.99), '&amp;', ('check_out', '=', False), ('check_in', '&lt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
