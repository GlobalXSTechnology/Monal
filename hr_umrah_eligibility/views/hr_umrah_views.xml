    <!--                <field name="enroll_in_umrah" string="Umrah Enroll"/>-->
    <!--            </xpath>-->
    <!--        </field>-->
    <!--    </record>-->

    <!-- UMRAH CONTRIBUTION LIST VIEW -->
    <record id="view_hr_umrah_contribution_list" model="ir.ui.view">
        <field name="name">hr.umrah.contribution.list</field>
        <field name="model">hr.umrah.contribution</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="contributed_percent"/>
                <field name="contribution_date"/>
                <field name="eligible_for_balloting"/>
            </list>
        </field>
    </record>

    <!-- UMRAH CONTRIBUTION FORM VIEW -->
    <record id="view_hr_umrah_contribution_form" model="ir.ui.view">
        <field name="name">hr.umrah.contribution.form</field>
        <field name="model">hr.umrah.contribution</field>
        <field name="arch" type="xml">
            <form string="Umrah Contribution">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="contributed_percent"/>
                        <field name="contribution_date"/>
                        <field name="eligible_for_balloting" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- UMRAH MENU ACTION -->
    <record id="action_hr_umrah_contribution" model="ir.actions.act_window">
        <field name="name">Umrah Contribution</field>
        <field name="res_model">hr.umrah.contribution</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_umrah_root"
              name="Umrah Contribution"
              parent="hr_death_grant.menu_hr_death_grant_root"
              sequence="90"
              action="action_hr_umrah_contribution"/>

    <!-- EMPLOYEE FORM UMRAH TAB -->
    <record id="view_employee_form_umrah" model="ir.ui.view">
        <field name="name">hr.employee.form.umrah</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[4]" position="after">
                <page string="Umrah Contributions" invisible="not contract_id.enroll_in_umrah">
                    <group>
                        <group>
                            <field name="umrah_cut_count"/>
                            <field name="manual_umrah_cut_add"/>
                            <field name="manual_umrah_amount_add"/>
                            <field name="umrah_monthly_cut" readonly="1"/>
                        </group>
                        <group>
                            <field name="umrah_total_expense"/>
                            <field name="umrah_remaining_balance"/>
                            <field name="umrah_total_cut" readonly="1"/>
                            <!--                            <field name="can_apply_for_umrah" readonly="1"/>-->
                        </group>
                    </group>
<!--                    <field name="umrah_contribution_ids">-->
<!--                        <list editable="bottom">-->
<!--                            <field name="contribution_date"/>-->
<!--                            &lt;!&ndash;                            <field name="contributed_percent"/>&ndash;&gt;-->
<!--                            &lt;!&ndash;                            <field name="eligible_for_balloting"/>&ndash;&gt;-->
<!--                        </list>-->
<!--                    </field>-->
<!--                    <button name="action_add_manual_month"-->
<!--                            string="Add Manual Month"-->
<!--                            type="object"-->
<!--                            class="btn-primary"-->
<!--                    />-->
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_umrah_contribution_form_custom" model="ir.ui.view">
        <field name="name">hr.umrah.contribution.form.custom</field>
        <field name="model">hr.umrah.contribution</field>
        <field name="arch" type="xml">
            <form string="Umrah Contribution Detail">
                <!--            <header>-->
                <!--                <button name="action_draft" string="Draft" type="object" states="confirm"/>-->
                <!--                <button name="action_confirm" string="Confirm" type="object" states="draft"/>-->
                <!--                <field name="stage" widget="statusbar"/>-->
                <!--            </header>-->
                <sheet>
                    <group>
                        <!--                    <field name="employee_id"/>-->
                        <field name="contributed_percent"/>
                        <field name="contribution_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_umrah_contribution_custom" model="ir.actions.act_window">
        <field name="name">Umrah Contributions</field>
        <field name="res_model">hr.umrah.contribution</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_umrah_contribution_form_custom"/>
    </record>
    <!-- Action -->
    <record id="action_hr_umrah_deduction_status" model="ir.actions.act_window">
        <field name="name">Umrah Deduction Status</field>
        <field name="res_model">hr.umrah.deduction.status</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hr_umrah_deduction_status"
              name="Umrah Deduction Status"
              parent="hr.menu_hr_root"
              action="action_hr_umrah_deduction_status"
              sequence="50"/>

    <!-- Form View -->
    <record id="view_hr_umrah_deduction_status_form" model="ir.ui.view">
        <field name="name">hr.umrah.deduction.status.form</field>
        <field name="model">hr.umrah.deduction.status</field>
        <field name="arch" type="xml">
            <form string="Umrah Deduction Status">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Employees With Deduction">
                            <field name="deducted_employee_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="umrah_cut_count"/>
                                    <field name="umrah_total_cut"/>
                                    <field name="company_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employees Without Deduction">
                            <field name="not_deducted_employee_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="company_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payslips of Deducted Employees">
                            <field name="payslip_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="state"/>
                                    <field name="company_id"/>
                                    <!--                                <field name="amount"/>-->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_employee_form_inherit_umrah" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.umrah</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Button ko header me add karne ke liye -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_payslips"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <field name="total_payslips" string="Umrah Payslips" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
