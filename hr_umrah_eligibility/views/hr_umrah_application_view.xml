<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- list View -->
    <record id="view_hr_umrah_application_list" model="ir.ui.view">
        <field name="name">hr.umrah.application.list</field>
        <field name="model">hr.umrah.application</field>
        <field name="arch" type="xml">
            <list string="Umrah Applications">
                <field name="employee_id"/>
                <field name="application_date"/>
                <field name="eligible"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_umrah_application_form" model="ir.ui.view">
        <field name="name">hr.umrah.application.form</field>
        <field name="model">hr.umrah.application</field>
        <field name="arch" type="xml">
            <form string="Umrah Application" create="true" edit="true">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-light"
                            invisible="state != 'confirmed'"/>
                    <button name="action_create_umrah_payment" type="object" string="Create Payment" class="btn-success"
                            invisible="state != 'confirmed' or is_confirmed"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_umrah_payment"
                                type="object"
                                string="View Payment"
                                icon="fa-money"
                                class="oe_stat_button"
                        />
                    </div>

                    <!-- rest of your group and fields here -->
                    <group>


                        <group>
                            <field name="employee_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="basic_salary" readonly="1"/>
                            <field name="application_date"/>
                            <field name="umrah_monthly_cut" readonly="1" invisible="1"/>
                            <field name="umrah_cut_count" readonly="1" invisible="1"/>
                            <field name="umrah_total_cut" readonly="1" invisible="1"/>
                            <field name="state" readonly="1" invisible="1"/>
                            <field name="company_id" readonly="1" invisible="1"/>


                        </group>
                        <group>
                            <field name="badge_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="joining_date" readonly="1"/>
                             <field name="expense_amount" readonly="1"
                            />
                        </group>
                    </group>
                                    <group string="Attachments">
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_hr_umrah_application" model="ir.actions.act_window">
        <field name="name">Umrah Applications</field>
        <field name="res_model">hr.umrah.application</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Umrah Application
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <!--    <menuitem id="menu_hr_umrah_root" name="Umrah" sequence="1000" />-->

    <menuitem id="menu_hr_umrah_application" name="Umrah Applications"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_umrah_application" sequence="10"/>

    <record id="view_umrah_expense_policy_list" model="ir.ui.view">
        <field name="name">hr.umrah.expense.policy.list</field>
        <field name="model">hr.umrah.expense.policy</field>
        <field name="arch" type="xml">
            <list string="Umrah Expense Policies">
                <field name="name"/>
                <field name="company_id"/>
                <field name="expense_amount"/>
                <field name="active"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_umrah_expense_policy_form" model="ir.ui.view">
        <field name="name">hr.umrah.expense.policy.form</field>
        <field name="model">hr.umrah.expense.policy</field>
        <field name="arch" type="xml">
            <form string="Umrah Expense Policy">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="expense_amount"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_umrah_expense_policy" model="ir.actions.act_window">
        <field name="name">Umrah Expense Policies</field>
        <field name="res_model">hr.umrah.expense.policy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your company's Umrah expense policies here.
            </p>
        </field>
    </record>
    <menuitem id="menu_hr_umrah_root" name="Umrah" parent="hr.menu_hr_root"/>

    <menuitem id="menu_hr_umrah_policies" name="Expense Policies"
              parent="menu_hr_umrah_root" action="action_umrah_expense_policy"/>

</odoo>
