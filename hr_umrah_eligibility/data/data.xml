<odoo>
    <data noupdate="1">

        <record id="hr_umrah_application_rule" model="ir.rule">
            <field name="name">HR Umrah Application</field>
            <field name="model_id" ref="model_hr_umrah_application"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="hr_umrah_deduction_status_rule" model="ir.rule">
            <field name="name">HR Umrah Deduction Status Rule</field>
            <field name="model_id" ref="model_hr_umrah_deduction_status"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="hr_umrah_expense_policy_rule" model="ir.rule">
            <field name="name">HR Umrah Expense Policy Rule</field>
            <field name="model_id" ref="model_hr_umrah_expense_policy"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>


    </data>
</odoo>
