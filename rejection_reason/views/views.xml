<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rejection Reason -->
    <record id="view_rejection_reason_tree" model="ir.ui.view">
        <field name="name">rejection.reason.list</field>
        <field name="model">rejection.reason</field>
        <field name="arch" type="xml">
            <list string="Rejection Reason">
                <field name="name" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="view_rejection_reason_form" model="ir.ui.view">
        <field name="name">rejection.reason.form</field>
        <field name="model">rejection.reason</field>
        <field name="arch" type="xml">
            <form string="Rejection Reason">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_rejection_reason" model="ir.actions.act_window">
        <field name="name">Rejection Reason</field>
        <field name="res_model">rejection.reason</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            </p>
        </field>
    </record>
    <menuitem
            id="menu_rejection_reason"
            name="Rejection Reason"
            action="action_rejection_reason"
            parent="stock.menu_stock_config_settings"
            sequence="200"/>

</odoo>