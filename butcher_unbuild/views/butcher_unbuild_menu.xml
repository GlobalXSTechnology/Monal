    <menuitem id="menu_butcher_unbuild" name="Butchery"
              parent="menu_mrp_operations_butcher"
              action="butcher_unbuild.butchery_mrp_unbuild"
              sequence="60"/>

    <record id="action_butcher_products" model="ir.actions.act_window">
        <field name="name">Butchery Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_butcher_product', '=', True)]</field>
    </record>

    <menuitem id="menu_butcher_products"
              name="Butchery Products"
              parent="menu_mrp_operations_butcher"
              action="action_butcher_products"
              sequence="70"/>
    <!-- Action for Assign Factor (regular model) -->
    <record id="action_assign_factor" model="ir.actions.act_window">
        <field name="name">Assign Factor</field>
        <field name="res_model">assign.factor</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item under Butcher Menu -->
    <menuitem id="menu_assign_factor"
              name="Assign Factor"
              parent="menu_mrp_operations_butcher"
              action="action_assign_factor"
              sequence="80"
              active="False"
    />


</odoo>
