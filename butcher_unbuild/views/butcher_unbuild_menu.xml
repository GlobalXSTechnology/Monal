    <record model="ir.actions.act_window" id="butchery_mrp_unbuild">
        <field name="name">Butchery Orders</field>
        <field name="res_model">mrp.unbuild</field>
        <field name="view_mode">list,kanban,form,activity</field>
            <field name="context">{'default_is_butchery': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No Butchery order found
          </p><p>
            A Butchery order is used to break down a finished product into its components.
          </p>
        </field>
    </record>
    <menuitem id="menu_mrp_operations_butcher" name="Butchery"
              sequence="50"
    web_icon="butcher_unbuild,static/description/icon.png"/>

