<odoo>
    <template id="uniform_pdf">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="docs"/>
            <div class="header">
                <div class="row" height="10px">
                    <div class="col-8">
                        <h3 style="text-align: left">
                            <b t-field="res_company.name"/>

                        </h3>
                    </div>
                    <div class="col-4" style="text-align:right;">
                        <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" width="100px"
                             height="60px"/>
                    </div>
                </div>
            </div>

            <main>
                <h2 style="text-align:center; font-weight:bold; margin-bottom:30px;">
                    Employee Uniform Distribution Report
                </h2>

                <div style="width:100%; margin-bottom:20px;">
                    <div style="width:48%; display:inline-block; vertical-align:top;">
                        <p style="margin:5px 0;">
                            <strong>Source Location:</strong>
                            <t t-esc="doc.source_location_id.name"/>
                        </p>
                        <p style="margin:5px 0;">
                            <strong>Destination Location:</strong>
                            <t t-esc="doc.destination_location_id.name"/>
                        </p>
                    </div>


                    <div style="width:48%; display:inline-block; vertical-align:top;">
                        <p style="margin:5px 0;">
                            <strong>Reference:</strong>
                            <t t-esc="doc.name"/>
                        </p>
                        <p style="margin:5px 0;">
                            <strong>Date:</strong>
                            <t t-esc="doc.distribution_date"/>
                        </p>
                        <p style="margin:5px 0;">
                            <strong>Company:</strong>
                            <t t-esc="doc.company_id.name"/>
                        </p>
                    </div>


                </div>
                <table class="table table-sm table-bordered"
                       style="width:100%; border-collapse:collapse; margin-top:20px; border:2px solid #000;">
                    <thead style="background-color:#f8f9fa;">
                        <tr style="border:2px solid #000;">
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Sr No
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">
                                Employee
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">
                                Product
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Check
                                Type
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">
                                Available Qty
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Badge
                                Id
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Payment
                                Amount
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Cost
                                Price
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Charged
                                Price
                            </th>
<!--                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Basic-->
<!--                                Salary-->
<!--                            </th>-->
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">
                                Designation
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Joining
                                Date
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">
                                Department
                            </th>
<!--                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">-->
<!--                                Company-->
<!--                            </th>-->
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Issued
                                Before
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Planned
                                Qty
                            </th>
                            <th style="border:1px solid #000; padding:8px; text-align:center; font-weight:bold;">Actual
                                Issued
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-foreach="doc.line_ids" t-as="line">
                            <tr style="border:1px solid #000;">
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-esc="line.sr_no"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="line.employee_id.name"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="line.product_id.name"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-if="line.check_filter == 'used'">Issue</t>
                                    <t t-elif="line.check_filter == 'return'">Return</t>
                                    <t t-elif="line.check_filter == 'new'">Replace</t>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-esc="line.available_qty"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-esc="line.badge_id"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:right;">
                                    <t t-esc="line.payment_amount"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:right;">
                                    <t t-esc="line.cost_price"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:right;">
                                    <t t-esc="line.charged_price"/>
                                </td>
<!--                                <td style="border:1px solid #000; padding:6px; text-align:right;">-->
<!--                                    <t t-esc="line.basic_salary"/>-->
<!--                                </td>-->
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="line.job_id.name"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-esc="line.joining_date"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="line.department_id.name"/>
                                </td>
<!--                                <td style="border:1px solid #000; padding:6px;">-->
<!--                                    <t t-esc="line.company_id.name"/>-->
<!--                                </td>-->
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-esc="line.total_issued_to_employee"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-esc="line.quantity"/>
                                </td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">
                                    <t t-esc="line.done_quantity"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </main>
            <div class="footer" style="margin-top: 80px; width: 100%;">
                <table style="width: 100%; text-align: center;">
                    <tr>
                        <td style="width: 33%; padding: 0 20px;">
                            <div style="border-top: 2px solid #000; padding-top: 8px;">
                                Employee Signature
                            </div>
                        </td>
                        <td style="width: 33%; padding: 0 20px;">
                            <div style="border-top: 2px solid #000; padding-top: 8px;">
                                Hr Signature
                            </div>
                        </td>
                        <td style="width: 33%; padding: 0 20px;">
                            <div style="border-top: 2px solid #000; padding-top: 8px;">
                                Store Signature
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>
</odoo>