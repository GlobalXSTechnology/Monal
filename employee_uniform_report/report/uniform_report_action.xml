<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="paperformat_landscape_a4" model="report.paperformat">
        <field name="name">Uniform Distribution Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>
    <record id="uniform_distribution_report_action" model="ir.actions.report">
        <field name="name">Uniform Distribution Report</field>
        <field name="model">employee.uniform</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_uniform_report.uniform_pdf</field>
        <field name="print_report_name">'Uniform Distribution - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_landscape_a4"/>
        <field name="binding_model_id" ref="employee_uniform.model_employee_uniform"/>
        <field name="binding_type">report</field>
    </record>


    <record id="employee_uniform_form_inherit" model="ir.ui.view">
    <field name="name">employee.uniform.form.inherit.report</field>
    <field name="model">employee.uniform</field>
    <field name="inherit_id" ref="employee_uniform.view_employee_uniform_form"/>
    <field name="arch" type="xml">
        <xpath expr="//header/button[@name='action_draft']" position="after">
            <button name="%(uniform_distribution_report_action)d"
                    type="action"
                    string="Print Report"
                    class="btn-secondary"
                    context="{'active_model': 'employee.uniform', 'active_id': id}"/>
        </xpath>
    </field>
    </record>
</odoo>

