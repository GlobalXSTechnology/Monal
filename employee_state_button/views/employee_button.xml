            <xpath expr="//header" position="inside">

                <!-- STATUS BAR -->
                <field name="state"
                       widget="statusbar"
                       statusbar_visible="draft,gm_project,hr_approval,gm_hr"/>

                <!-- SUBMIT TO DRAFT -->
                <button name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        invisible="state == 'draft'"/>


                <!-- SUBMIT GM PROJECT -->
                <button name="action_gm_project"
                        type="object"
                        string="Submit to GM Project"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                <!-- SUBMIT HR -->
                <button name="action_hr_approval"
                        type="object"
                        string="Submit to HR Approval"
                        class="btn-info"
                        invisible="state != 'gm_project'"/>

                <!-- SUBMIT GM HR -->
                <button name="action_gm_hr"
                        type="object"
                        string="Submit to GM HR"
                        class="btn-success"
                        invisible="state != 'hr_approval'"/>

                <!-- LOCK -->
                <button name="action_lock"
                        type="object"
                        string="Lock"
                        class="btn-danger"
                        invisible="is_locked == True"/>

                <!-- UNLOCK -->
                <button name="action_unlock"
                        type="object"
                        string="Unlock"
                        class="btn-secondary"
                        invisible="is_locked == False"/>

