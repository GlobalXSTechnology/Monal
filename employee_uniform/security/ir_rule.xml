<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record model="ir.rule" id="employee_uniform_distribution">
        <field name="name">Employee Uniform Distribution</field>
        <field name="model_id" search="[('model','=','employee.uniform')]" model="ir.model"/>
        <field name="domain_force">[('company_id','in', company_ids + [False])]</field>
    </record>
    <record model="ir.rule" id="employee_uniform_line">
        <field name="name">Employee Uniform Line</field>
        <field name="model_id" search="[('model','=','employee.uniform.line')]" model="ir.model"/>
        <field name="domain_force">[('company_id','in', company_ids + [False])]</field>
    </record>

    </data>
</odoo>