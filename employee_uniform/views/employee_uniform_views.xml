<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_employee_uniform" model="ir.sequence">
            <field name="name">Employee Uniform Reference</field>
            <field name="code">employee.uniform</field>
            <field name="prefix">UNIF-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
        </record>
    </data>

    <record id="view_employee_uniform_form" model="ir.ui.view">
        <field name="name">employee.uniform.form</field>
        <field name="model">employee.uniform</field>
        <field name="arch" type="xml">
            <form string="Uniform Distribution">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

<!--                    <button name="action_done"-->
<!--                            type="object"-->
<!--                            string="Mark as Done"-->
<!--                            class="btn-primary"-->
<!--                            invisible="state != 'confirmed'"/>-->
                    <button name="action_draft"
                            type="object"
                            string="Set to Draft"
                            class="btn-secondary"
                            invisible="state != 'confirmed'"/>/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box" invisible="not picking_id">
                        <button name="action_view_internal_transfers"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">
                            <field name="picking_id" widget="statinfo" string="Internal Transfer"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="destination_location_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="distribution_date" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <!--                            <field name="total_payment" readonly="1"/>-->
                        </group>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="check_filter" readonly="state != 'draft'"/>

                            <field name="available_qty" readonly="1"/>
                            <field name="badge_id" readonly="1"/>
                            <field name="payment_amount"/>
                            <field name="cost_price" readonly="1"/>
                            <field name="charged_price" readonly="state != 'draft'"
                            />
<!--                            <field name="basic_salary" readonly="1"/>-->
                            <field name="job_id" readonly="1"/>
                            <field name="joining_date" readonly="1"/>
                            <field name="department_id" readonly="1"/>
<!--                            <field name="company_id" readonly="1"/>-->
                            <field name="total_issued_to_employee" string="Issued Before" readonly="1"/>

                            <field name="quantity" string="Planned Qty"
                                   readonly="state != 'draft'"
                                   sum="Total Planned"/>

                            <field name="done_quantity" string="Actual Issued"
                                   readonly="state != 'draft'"
                                   sum="Total Issued"/>

                            <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>

                            <button name="action_view_issued_wizard"
                                    type="object"
                                    string="View History"
                                    class="btn-secondary"
                                    icon="fa-history"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_employee_uniform_list" model="ir.ui.view">
        <field name="name">employee.uniform.list</field>
        <field name="model">employee.uniform</field>
        <field name="arch" type="xml">
            <list decoration-danger="half_price">
                <field name="name" string="Reference No"/>
                <field name="distribution_date"/>
                <field name="state"/>
                <field name="total_payment"/>
                <field name="half_price"/>
            </list>
        </field>
    </record>

    <record id="action_employee_uniform" model="ir.actions.act_window">
        <field name="name">Employee Uniforms</field>
        <field name="res_model">employee.uniform</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_employee_uniform"
              name="Distribute Uniforms"
              parent="hr_death_grant.menu_hr_death_grant_root"
              action="action_employee_uniform"/>

    <record id="view_employee_form_inherit_uniform" model="ir.ui.view">
        <field name="name">hr.employee.uniform.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_uniforms"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-user">
                    <field name="total_uniforms_issued" widget="statinfo" string="Uniforms Issued"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="total_uniforms_issued" readonly="1" invisible="1"/>
            </xpath>
        </field>
    </record>


    <record id="view_update_done_quantity_wizard_form" model="ir.ui.view">
        <field name="name">update.done.quantity.wizard.form</field>
        <field name="model">update.done.quantity.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Issued Quantity">
                <sheet>
                    <group>
                        <group>
                            <field name="current_quantity"/>
                            <field name="current_done_quantity"/>
                        </group>
                        <group>
                            <field name="new_done_quantity"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Update" name="action_update" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_update_all_quantities_wizard_form" model="ir.ui.view">
        <field name="name">update.all.quantities.wizard.form</field>
        <field name="model">update.all.quantities.wizard</field>
        <field name="arch" type="xml">
            <form string="Update All Issued Quantities">
                <sheet>
                    <field name="uniform_id" readonly="1"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="employee_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="planned_quantity" readonly="1"/>
                            <field name="current_done_quantity" readonly="1"/>
                            <field name="new_done_quantity"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Update All" name="action_update_all" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>