<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="outward_gatepass_print_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="doc">

                    <div class="page" style="font-size:13px;">

                        <!-- ================= HEADER WITH LOGO ================= -->
                        <div style="text-align:center; margin-bottom:10px;">
                            <h2 style="margin:0;">
                                MONAL GROUP
                            </h2>
                        </div>

                        <table class="o_has_total_table table o_main_table table-borderless" width="100%"
                               style="margin-bottom:12px;">
                            <tr>


                                <td width="30%" style="text-align:left; vertical-align:bottom;">
                                    <span style="font-size:14px; font-weight:600;">
                                        Employee Gate Pass
                                    </span>
                                </td>

                                <!-- CENTER : MONAL GROUP -->
                                <!--                                <td width="40%" style="text-align:center; vertical-align:top; padding-top:-15px;">-->
                                <!--                                    <h2 style="margin:0;">-->
                                <!--                                        MONAL GROUP-->
                                <!--                                    </h2>-->
                                <!--                                </td>-->


                                <!-- RIGHT : DATE -->
                                <td width="30%" style="text-align:left; font-size:12px; vertical-align:bottom;">
                                    <strong>Created On:</strong>
                                    <t t-if="doc.create_date">
                                        <span t-esc="context_timestamp(doc.create_date).strftime('%d-%m-%Y %H:%M:%S')"/>
                                    </t>
                                </td>
                                <td width="33.3%" style="text-align:left; font-size:11px; vertical-align:bottom;">
                                    <strong>Print Date:</strong>
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M:%S')"/>
                                </td>


                            </tr>

                        </table>

                        <!-- ================= EMPLOYEE INFORMATION ================= -->
                        <table class="o_has_total_table table o_main_table table-borderless"
                               style="margin-bottom:12px;">
                            <tr style="background:#f2f2f2;">
                                <td width="25%">
                                    <strong>ID #</strong>
                                </td>
                                <td width="25%">
                                    <t t-esc="doc.badge_id"/>
                                </td>
                                <td width="25%">
                                    <strong>Department</strong>
                                </td>
                                <td width="25%">
                                    <t t-esc="doc.department.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Name</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.name.name"/>
                                </td>
                                <td>
                                    <strong>Type</strong>
                                </td>
                                <td style="text-transform:capitalize;">
                                    <t t-esc="doc.gate_pass_type"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Purpose</strong>
                                </td>
                                <td>
                                    <span t-field="doc.description"/>
                                </td>
                                <td>
                                    <strong>Designation</strong>
                                </td>
                                <td>
                                    <span t-field="doc.designation"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ================= TIME DETAILS ================= -->
                        <table class="o_has_total_table table o_main_table table-borderless">
                            <tr style="background:#f2f2f2;">
                                <td width="25%">
                                    <strong>Check In</strong>
                                </td>
                                <td width="25%">
                                    <t t-if="doc.check_in">
                                        <span t-esc="context_timestamp(doc.check_in).strftime('%d-%m-%Y %H:%M:%S')"/>
                                    </t>

                                    
                                    <!-- <span t-field="doc.check_in_display"/> -->
                                    <!--                                    <t t-if="doc.time_out_display">-->
                                    <!--                                        <t t-esc="doc.karachi_time_out()"/>-->
                                    <!--                                    </t>-->
                                </td>
                                <td width="25%">
                                    <strong>Check Out</strong>
                                </td>
                                <td width="25%">
                                    <t t-if="doc.check_out">
                                        <span t-esc="context_timestamp(doc.check_out).strftime('%d-%m-%Y %H:%M:%S')"/>
                                    </t>
                                    
                                    <!-- <span t-field="doc.check_out_display"/> -->
                                    <!--                                    <t t-if="doc.time_in_display">-->
                                    <!--                                        <t t-esc="doc.karachi_time_in()"/>-->
                                    <!--                                    </t>-->
                                </td>
                            </tr>
                            <tr style="background:#f2f2f2;">
                                <td width="25%">
                                    <strong>Time Out</strong>
                                </td>
                                <td width="25%">
                                    <t t-if="doc.time_out">
                                        <span t-esc="context_timestamp(doc.time_out).strftime('%d-%m-%Y %H:%M:%S')"/>
                                    </t>
                                    <!--                                    <t t-if="doc.time_out_display">-->
                                    <!--                                        <t t-esc="doc.karachi_time_out()"/>-->
                                    <!--                                    </t>-->
                                </td>
                                <td width="25%">
                                    <strong>Time In</strong>
                                </td>
                                <td width="25%">
                                    <t t-if="doc.time_in">
                                        <span t-esc="context_timestamp(doc.time_in).strftime('%d-%m-%Y %H:%M:%S')"/>
                                    </t>
                                    <!-- <span t-field="doc.time_in_display"/> -->
                                    <!--                                    <t t-if="doc.time_in_display">-->
                                    <!--                                        <t t-esc="doc.karachi_time_in()"/>-->
                                    <!--                                    </t>-->
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Total Time (Hours)</strong>
                                </td>
                                <td>
                                    <span t-esc="'%02d:%02d' % (int(doc.total_time), int(round((doc.total_time % 1) * 60)))"/>
                                </td>
                                <td>
                                    <strong>Amount Deduct</strong>
                                </td>
                                <td>
                                    <span t-esc="round(doc.amount_deduc, 2)"/>
                                </td>
                            </tr>
                        </table>

                        <br/>
                        <br/>

                        <!-- ================= SIGNATURES ================= -->
                        <table class="o_has_total_table table o_main_table table-borderless" width="100%"
                               style="margin-top:40px;">
                            <tr>
                                <td style="text-align:center;">
                                    ___________________________
                                    <br/>
                                    <strong>Employee Signature</strong>
                                </td>
                                <td style="text-align:center;">
                                    ___________________________
                                    <br/>
                                    <strong>HR Signature</strong>
                                </td>
                                <td style="text-align:center;">
                                    ___________________________
                                    <br/>
                                    <strong>GM/HOD Signature</strong>
                                </td>
                            </tr>
                        </table>

                    </div>

                </t>
            </t>
        </t>
    </template>

    <record id="paperformat_gatepass_half" model="report.paperformat">
        <field name="name">Gate Pass Half Page</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">210</field>
        <field name="page_height">138</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="orientation">Portrait</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>


    <record id="outward_gatepass_print" model="ir.actions.report">
        <field name="name">Employee Outward Gatepass</field>
        <field name="model">employee.gatepass</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">monal_employee_outward_gatepass.outward_gatepass_print_report_template</field>
        <field name="report_file">monal_employee_outward_gatepass.outward_gatepass_print_report_template</field>
        <field name="binding_model_id" ref="model_employee_gatepass"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'GatePass - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_gatepass_half"/>
    </record>


</odoo>
