<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>

		<template id="journal_entry_template_report_view">
			<t t-call="web.external_layout">
				<t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
				<div class="page">
					<br/>
					<div class="oe_structure"/>
					<div>
						<h2 class="text-center mb32">
							<strong>Journal Entry</strong>
						</h2>
					</div>
					<br/>
					<table style="width:100%;margin:0px auto;background:white;border:1px solid #e1e1e1;" class="table table-condensed">
						<tbody>
							<tr>
								<td><strong>Journal Entry : </strong></td>
								<td><p t-field="o.name"/></td>
								<td><strong>Journal :</strong></td>
								<td><p t-field="o.journal_id"/></td>
							</tr>
							<tr>
								<td><strong>Date :</strong></td>
								<td><p t-field="o.date"/></td>
								<td><strong>Reference :</strong></td>
								<td><p t-field="o.ref"/></td>
							</tr>
                            <tr>
								<td><strong>ID :</strong></td>
								<td><p t-field="o.id"/></td>
								<td/>
								<td/>
							</tr>
						</tbody>
					</table>
				<br/>

				<table style="width:100%;margin:0px auto;background:white;border:1px solid #e1e1e1;" class="table table-condensed">
					<t t-set="partner_id" t-value="any(l.partner_id for l in o.line_ids)"/>
					<t t-set="date_maturity" t-value="any(l.date_maturity for l in o.line_ids)"/>
					<t t-set="analytic_distribution" t-value="any(l.analytic_distribution for l in o.line_ids)"/>
					<t t-set="tax_ids" t-value="any(l.tax_ids for l in o.line_ids)"/>
					<thead>
						<tr>
							<th t-if="partner_id">Partner</th>
							<th>Account</th>
							<th>Label</th>
							<th t-if="date_maturity">Due Date</th>
							<th t-if="analytic_distribution">Analytic Account</th>
							<th t-if="tax_ids">Taxes(%)</th>
							<th>Debit</th>
							<th>Credit</th>
						</tr>
					</thead>  
					<tbody class="consumed_tbody">
						<t t-set="total" t-value="0.0"/>
						<t t-set="total1" t-value="0.0"/>
						<t t-foreach="o.line_ids" t-as="line">    
						<tr>
							<td t-if="partner_id">
								<span t-field="line.partner_id"/>
							</td>
							<td>
								<span t-field="line.account_id"/>
							</td>
							<td>
								<span t-field="line.name"/>
							</td>
							<td t-if="date_maturity">
								<span t-field="line.date_maturity"/>
							</td>
							<td t-if="analytic_distribution">
								<span>
									<div t-foreach="line.analytic_distribution" t-as="distribution">
										<t t-set="distributions" t-value="distribution.split(',')"/>
										<t t-foreach="distributions" t-as="dist">
											<t t-if="line.env['account.analytic.account'].browse(int(dist))[0].partner_id">
												<t t-esc="line.env['account.analytic.account'].browse(int(dist))[0].name"/>-
												<t t-esc="line.env['account.analytic.account'].browse(int(dist))[0].partner_id.name"/>,
												<t t-esc="line.analytic_distribution.get(dist)"/>
											</t>
											<t t-else="">
												<t t-esc="line.env['account.analytic.account'].browse(int(dist))[0].name"/>,
												<t t-esc="line.analytic_distribution.get(dist)"/>
											</t>
											<br/>
										</t>
									</div>
								</span>
							</td>
							<td t-if="tax_ids">
								<span t-field="line.tax_ids"/>
							</td>
							<td>
								<span t-field="line.debit"/>
							</td>
							<td>
								<span t-field="line.credit"/>
							</td>
						</tr>
						<t t-set="total" t-value="total + line.debit"/>
						<t t-set="total1" t-value="total1 + line.credit"/>
						</t>
						<tr>

							<td><strong>Total:</strong></td>
							<td t-if="partner_id"/>
							<td t-if="account_id"/>
							<td t-if="name"/>
							<td t-if="date_maturity"/>
							<td t-if="analytic_distribution"/>
							<td/>
							<td width="10%"><strong>
								<span><t t-esc="'{:,.2f}'.format(total)"/></span>
							</strong></td>
							 <td width="10%"><strong>
								<span><t t-esc="'{:,.2f}'.format(total1)"/></span>
							</strong></td>
					  	</tr>
					</tbody>
				</table>
				<div style="margin:30pt;">
                <span>Amount In Words:&#160;&#160;&#160;&#160;
                    <span style="text-decoration: underline;">
                        <strong>
                           <t t-esc="o.currency_id.amount_to_text(total)"/>
                        </strong>
                    </span>
                </span>
            </div>
            <div class="row" style="padding-top:20pt;margin-top:4em; text-align:center">
                <div class="col-8"/>
                <div class="col-4" align="center">
                    <span>
                        <span>&#160;Mob:________________________</span>
                    </span>
                </div>
            </div>

            <div class="row" style="padding-top:20pt;margin-top:4em; text-align:center">
                <div class="col-2" style="padding-left:10px;padding-right:10px;">
                    <div style="border-top: 3px double black;width:100%;">
                        <span>Finance Dept.
                        </span>
                    </div>
                </div>
                <div class="col-2" align="center" style="padding-left:10px;padding-right:10px;">
                    <div style="border-top: 3px double black;width:100%;">
                        <span>
                            <span>Approved By
                            </span>
                        </span>
                    </div>
                </div>
                <div class="col-2" align="center" style="padding-left:10px;padding-right:10px;">
                    <div style="border-top: 3px double black;width:100%;">
                        <span>
                            <span>Cashier
                            </span>
                        </span>
                    </div>
                </div>
                <div class="col-2" align="center" style="padding-left:10px;padding-right:10px;">
                    <div style="border-top: 3px double black;width:100%;">
                        <span>
                            <span>Received By
                            </span>
                        </span>
                    </div>
                </div>
                <div class="col-4" align="center">
                    <span>
                        <span>&#160;CNIC:________________________</span>
                    </span>
                </div>
            </div>
            <div class="footer" style="width:100%; border-top:1px solid #000; font-size:10px; padding-top:5px;">
                <div class="row" style="width:100%;">
                    <div class="col-2">
                        Entered By:&#160;
                        <span t-esc="o.create_uid.name or ''"/>&#160;
                    </div>
                    <div class="col-3 text-center">
                        Last Edited By:&#160;
                        <span t-esc="o.write_uid.name or ''"/>&#160;
                    </div>
                    <div class="col-3">
                        Print Date:&#160;
                        <t t-esc="o.create_date.strftime('%d-%m-%Y %H:%M:%S') if o.create_date else ''"/>&#160;
                    </div>
                    <div class="col-2 text-right">
                        Posted By:&#160;
                        <span t-esc="o.create_uid.name or ''"/>&#160;
                    </div>
                    <div class="col-2 text-right">
                        Page:&#160;
                        <span class="page"/>
                        /
                        <span class="topage"/>
                    </div>
                </div>
            </div>



				</div>
			</t>
		</template>

		<template id="journal_entry_report_template_id">
			<t t-call="web.html_container">
				<t t-foreach="docs" t-as="o">
					<t t-call="bi_print_journal_entries.journal_entry_template_report_view"  t-lang="o.partner_id.lang"/>
				</t>
			</t>
		</template>

	</data>
</odoo>
