<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_report_wizard" model="ir.ui.view">
        <field name="name">attendance.report.wizard.form</field>
        <field name="model">attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly Attendance Report">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from" string="From Date" required="1"/>
                            <field name="date_to" string="To Date" required="1"/>
                        </group>
                        <group>
                            <field name="select_employee"/>
                            <field name="company_id" invisible="select_employee != 'company'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="department_id" widget="many2many_tags"
                                   invisible="select_employee != 'department'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="employee_ids" widget="many2many_avatar_user"
                                   invisible="select_employee != 'employee'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">MIS Leave Summary Report</field>
        <field name="res_model">attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_attendance_report_wizard"/>
    </record>

    <record id="paperformat_mis_attendance" model="report.paperformat">
        <field name="name">MIS Leave Summary Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">1</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">55</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_mis_attendance" model="ir.actions.report">
        <field name="name">MIS Leave Summary Report</field>
        <field name="model">attendance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">monal_mis_leave_summary.report_monthly_attendance</field>
        <field name="print_report_name">'Monthly Attendance Report - %s' % (object.date_from)</field>
        <field name="binding_model_id" ref="model_attendance_report_wizard"/>
        <field name="paperformat_id" ref="paperformat_mis_attendance"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_monthly_attendance">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="container">
                        <h3 class="text-center">MIS Leave Summary Report</h3>
                        <br/>
                        <h4 class="text-left">Company:&#160;&#160;&#160;&#160;&#160;&#160;&#160;<span t-esc="company_name"/></h4>
                        <p>
                            <strong>Date Range:</strong>
                            <span t-esc="data.get('date_from')"/>
                            to
                            <span t-esc="data.get('date_to')"/>
                        </p>
                        <p style="margin: 5px 0; font-size: 12px; color: #7f8c8d;">
                            Generated on:
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %I:%M:%S %p')"/>
                        </p>
                        <t t-foreach="get_departments(data)" t-as="dept">
                            <h4>Department:
                                <span t-esc="dept.name"/>
                            </h4>
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr style="background-color: #f8f9fa;">
                                        <th>Sr No</th>
                                        <th>Emp Code</th>
                                        <th>Employee Name</th>
                                        <th>Designation</th>
                                        <th>Joining Date</th>
<!--                                        <th>Location</th>-->
                                        <th>Residence Type</th>
                                        <th>Opening</th>
                                        <th>Total Days</th>
                                        <th>Present</th>
                                        <th>Entitled</th>
                                        <th>Availed</th>
                                        <th>Encash</th>
                                        <th>Balance</th>
                                        <th>Waved Leave</th>
                                        <th>Balance After</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="get_employees_data(dept, data)" t-as="emp">
                                        <tr>
                                            <td class="text-center">
                                                <span t-esc="emp['sr_no']"/>
                                            </td>
                                            <td>
                                                <span t-esc="emp['emp_code']"/>
                                            </td>
                                            <td>
                                                <span t-esc="emp['name']"/>
                                            </td>
                                            <td>
                                                <span t-esc="emp['designation']"/>
                                            </td>
                                            <td>
                                                <span t-esc="emp['join_date']"/>
                                            </td>
<!--                                            <td>-->
<!--                                                <span t-esc="emp['location']"/>-->
<!--                                            </td>-->
                                            <td>
                                                <span t-esc="emp['residence_type']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['opening']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['total_days']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['present']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['entitled']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['availed']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['encash']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['balance']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['waved']"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="emp['balance_after']"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr style="background-color: #e9ecef; font-weight: bold;">
                                        <td colspan="6" class="text-center">Total</td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['opening'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['total_days'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['present'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['entitled'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['availed'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['encash'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['balance'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['waved'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="sum(emp['balance_after'] for emp in get_employees_data(dept, data))"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
    <menuitem
            id="menu_attendance_report"
            name="MIS Leave Summary Report"
            action="action_attendance_report_wizard"
            parent="hr_holidays.menu_hr_holidays_report"
            sequence="10"/>
</odoo>