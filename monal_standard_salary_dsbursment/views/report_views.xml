        <record id="report_salary_disbursment_employee" model="ir.actions.report">
            <field name="name">Standard Salary Sheet (Disbursment)</field>
            <field name="model">monal.standard.salary.disbursment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">monal_standard_salary_dsbursment.print_monal_salary_disbursment_template</field>
            <field name="report_file">monal_standard_salary_dsbursment.print_monal_salary_disbursment_template</field>
            <field name="binding_model_id" ref="model_monal_standard_salary_disbursment"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="monal_standard_salary_dsbursment.monal_salary_disbursment_report_paperformate"/>
        </record>
    </data>
</odoo>