<odoo>
    <data>
        <record id="view_hr_employee_grace" model="ir.ui.view">
            <field name="name">hr.employee.referral</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_ids']" position="after">
                    <field name="allowed_grace"/>
                </xpath>
            </field>
        </record>

        <record id="view_res_company_grace" model="ir.ui.view">
            <field name="name">res.company.grace</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="basic_govt_wage"/>
                </xpath>
            </field>
        </record>

        <record id="view_resource_calendar_grace" model="ir.ui.view">
            <field name="name">resource.calendar.grace</field>
            <field name="model">resource.calendar</field>
            <field name="inherit_id" ref="resource.resource_calendar_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tz']" position="after">
                    <field name="grace_hours" string="Grace Hours" widget="float_time"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>