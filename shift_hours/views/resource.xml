<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="resource_calendar_checkin_view_form" model="ir.ui.view">
        <field name="name">resource.calendar.checkin.view.form.inherit.hr.contract</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hours_per_day']" position="after">
                <field name="start_check" widget="float_time"/>
                <field name="end_check" widget="float_time"/>
            </xpath>
        </field>
    </record>
</odoo>