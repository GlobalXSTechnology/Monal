<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_multi_deduction" model="ir.ui.view">
        <field name="name">view.account.payment.form.multi.deduction</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="before">
                <field name="actual_amount" readonly="1" />
                <field name="is_locked" invisible="1"></field>
            </xpath>


            <xpath expr="//group[@name='main_group']" position="after">
                <group>
                    <field name="is_multiple_deduction"/>
                </group>
                <field name="deduction_ids" readonly="state == 'posted'" invisible="is_multiple_deduction == False">
                    <list editable="bottom">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="account_id"/>
                        <field name="tax_id"/>
                        <field name="is_direct_deduct"/>
                        <field name="use_deducted_amount_for_tax"/>
                        <field name="name"/>
                        <field name="amount" sum="Total Deduction" />
                    </list>
                </field>
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                        name="button_refresh_tax"
                        invisible="state not in ('draft') or is_locked == False"
                        string="Refresh With Holding Taxes"
                        type="object"
                        class="oe_highlight"
                    />
            </xpath>

            <xpath expr="//form[1]/sheet[1]/group[@name='main_group']/group[@name='group1']/div[@name='amount_div']/field[@name='amount']" position="attributes">
                <attribute name="force_save">1</attribute>
                <!-- <attribute name="readonly">state != "draft" or is_locked == True</attribute> -->
                <attribute name="readonly">state != 'draft'</attribute>  <!-- Rao Abdul Rehman -->

            </xpath>

            <xpath expr="//field[@name='deduction_ids']" position="attributes">
                <attribute name="force_save">1</attribute>
                <attribute name="readonly">is_locked == True</attribute>
            </xpath>

        </field>
    </record>
</odoo>