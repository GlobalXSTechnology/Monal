<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.monal</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='check_out_group']" position="after">
                <group string="Adjustment Info">
                    <field name="adjustment_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>