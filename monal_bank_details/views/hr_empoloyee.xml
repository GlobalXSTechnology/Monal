<odoo>
    <record id="view_hr_employee_form_inherit_bank_details" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Bank Details">
                    <group>
                        <group>
                            <field name="amount_2"/>
                            <field name="acc_no"/>
                            <field name="beneficiary_code"/>
                            <field name="bank_name"/>
                            <field name="account_holder"/>
                            <field name="reference_1"/>
                            <field name="reference_2"/>
                        </group>
                        <group>
                            <field name="beneficiary_email"/>
                            <field name="beneficiary_mobile"/>
                            <field name="product_type_code"/>
                        </group>
                    </group>

                </page>
            </xpath>
        </field>
    </record>
</odoo>