<odoo>
    <record id="view_hr_contract_form_inherit_lock" model="ir.ui.view">
        <field name="name">hr.contract.form.lock.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_lock"
                        string="Lock"
                        type="object"
                        class="btn-primary"
                        groups="hr_contract.group_hr_contract_manager"
                        invisible="state != 'open' or is_locked"/>
                <button name="action_unlock"
                        string="Unlock"
                        type="object"
                        class="btn-secondary"
                        groups="hr_contract.group_hr_contract_manager"
                        invisible="state != 'open' or not is_locked"/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="replace">
                <field name="date_start" readonly="state == 'open' and is_locked"/>
            </xpath>

            <xpath expr="//field[@name='date_end']" position="replace">
                <field name="date_end" readonly="state == 'open' and is_locked"/>
            </xpath>

            <xpath expr="//field[@name='wage']" position="replace">
                <field name="wage" readonly="state == 'open' and is_locked"/>
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="replace">
                <field name="resource_calendar_id" readonly="state == 'open'"/>
            </xpath>
<!--            <xpath expr="//field[@name='work_entry_source']" position="replace">-->
<!--                <field name="work_entry_source" readonly="state == 'open'"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='structure_type_id']" position="replace">-->
<!--                <field name="structure_type_id" readonly="state == 'open'"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='department_id']" position="replace">-->
<!--                <field name="department_id" readonly="state == 'open'"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='job_id']" position="replace">-->
<!--                <field name="job_id" readonly="state == 'open'"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='contract_type_id']" position="replace">-->
<!--                <field name="contract_type_id" readonly="state == 'open'"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='wage_type']" position="replace">-->
<!--                <field name="wage_type" readonly="state == 'open'"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='schedule_pay']" position="replace">-->
<!--                <field name="schedule_pay" readonly="state == 'open'"/>-->
<!--            </xpath>-->

            <xpath expr="//field[not(@name='date_start' or @name='date_end' or @name='wage')]" position="attributes">
                <attribute name="readonly">state == 'open' and is_locked</attribute>
            </xpath>


        </field>
    </record>
</odoo>