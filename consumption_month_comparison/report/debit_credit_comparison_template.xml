<odoo>
    <!-- Report Action -->
    <record id="month_comparison_account_report" model="ir.actions.report">
        <field name="name">Debit And Credit</field>
        <field name="model">month.comparison.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">consumption_month_comparison.account_report_template</field>
        <field name="report_file">consumption_month_comparison.account_report_template</field>
        <field name="print_report_name">'Debit_Credit_Comparison_' + (object.create_uid.name or 'Report')</field>
    </record>

    <!-- Report Template -->
    <template id="account_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h3 style="text-align:center; margin-bottom:10px;">
                        Month-wise Debit / Credit Report
                    </h3>

                    <div class="row mt-4" style="margin-bottom: 20px;">
                        <div class="col-6" style="text-align:left;">
<!--                            <p>-->
<!--                                <strong>Period:</strong>-->
<!--                                <span t-esc="data.get('start_date')"/> to-->
<!--                                <span t-esc="data.get('end_date')"/>-->
<!--                            </p>-->
                            <p>
                                <strong>Filter By:</strong>
                                <t t-if="data.get('filter_type') == 'category'">
                                    Category
<!--                                    <span t-if="data.get('category')"> (<t t-esc="data['category']"/>)</span>-->
                                </t>
                                <t t-if="data.get('filter_type') == 'product'">
                                    Product
<!--                                    <span t-if="data.get('product')"> (<t t-esc="data['product']"/>)</span>-->
                                </t>
                            </p>
                        </div>
                        <div class="col-6" style="text-align:left;">
                            <p>
                                <strong>Consumption Location:</strong>
                                <span t-esc="data.get('source_location')"/>
                            </p>
                            <p>
                                <strong>To Location:</strong>
                                <span t-esc="data.get('dest_location')"/>
                            </p>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table"
                           style="width:100%; border-collapse: collapse; border:1px solid black; font-size:12px;">
                        <thead>
                            <tr>
                                <th style="border:1px solid black; text-align:left;">Name</th>
                                <t t-if="data and data.get('month_headers')">
                                    <t t-foreach="data['month_headers']" t-as="mh">
                                        <th colspan="2" style="border:1px solid black; text-align:center;">
                                            <t t-esc="mh"/>
                                        </th>
                                    </t>
                                </t>
                            </tr>
                            <tr>
                                <th style="border:1px solid black;"></th>
                                <t t-foreach="data['month_headers']" t-as="mh">
                                    <th style="border:1px solid black; text-align:center;">Debit</th>
                                    <th style="border:1px solid black; text-align:center;">Credit</th>
                                </t>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-if="data.get('lines')">
                                <t t-foreach="data['lines']" t-as="line">
                                    <tr>
                                        <td style="border:1px solid black;">
                                            <t t-esc="line['name']"/>
                                        </td>
                                        <t t-foreach="line['months']" t-as="mdata">
                                            <td style="border:1px solid black; text-align:right;">
                                                <t t-esc="mdata['debit']"/>
                                            </td>
                                            <td style="border:1px solid black; text-align:right;">
                                                <t t-esc="mdata['credit']"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                            <t t-if="not data.get('lines')">
                                <tr>
                                    <td colspan="100%" style="text-align:center; border:1px solid black;">
                                        ⚠ No Debit / Credit records found for the selected period
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
